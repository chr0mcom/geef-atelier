<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);MCPEXP005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.Extensions.Skills" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Skills\**\*.md" LogicalName="Geef.Atelier.Mcp.Skills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Geef.Atelier.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Geef.Atelier.Application\Geef.Atelier.Application.csproj" />
    <ProjectReference Include="..\Geef.Atelier.Infrastructure\Geef.Atelier.Infrastructure.csproj" />
  </ItemGroup>

</Project>
