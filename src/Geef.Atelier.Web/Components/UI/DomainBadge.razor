@using Geef.Atelier.Core.Domain.Crew.Models
@using Geef.Atelier.Web.Display
@if (_label is not null)
{
    <span class="domain-badge domain-badge--@_label.ToLowerInvariant()" data-testid="domain-badge">
        @_label
    </span>
}

@code {
    [Parameter] public string? TemplateName { get; set; }

    [Parameter] public ModelDomain? Domain { get; set; }

    private string? _label => Domain is { } domain and not ModelDomain.General
        ? domain.ToString()
        : ReviewerDisplay.GetTemplateDomain(TemplateName);
}
