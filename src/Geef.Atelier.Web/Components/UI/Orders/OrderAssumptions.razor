@using Geef.Atelier.Application.Orders
@using System.Globalization

@if (Lines.Count > 0 || NotGiven.Count > 0)
{
    <section class="order-block order-assumptions" aria-labelledby="order-assumptions-title" data-testid="order-assumptions">
        <h2 id="order-assumptions-title">Assumptions</h2>
        @if (Result.AssumptionsVersion is int noted)
        {
            @if (Current.Count > 0)
            {
                <p data-testid="order-assumptions-change-lead">@RevisionLines.ChangeNotesLead</p>
                <ul>
                    @foreach (var line in Current)
                    {
                        <li data-testid="order-assumption" lang="@Language">@line</li>
                    }
                </ul>
            }
            @if (Noted.Count + NotGiven.Count > 0)
            {
                <details class="order-earlier" data-testid="order-earlier-details">
                    <summary>@RevisionLines.EarlierNotesSummary(Noted.Count + NotGiven.Count, [noted])</summary>
                    @if (Noted.Count > 0)
                    {
                        <p data-testid="order-assumptions-noted-lead">@string.Format(CultureInfo.InvariantCulture, RevisionLines.AssumptionsNotedLeadFormat, noted)</p>
                        <ul>
                            @foreach (var line in Noted)
                            {
                                <li data-testid="order-assumption" data-noted-for="@noted" lang="@Language">@line</li>
                            }
                        </ul>
                    }
                    @if (NotGiven.Count > 0)
                    {
                        <p data-testid="order-not-given-lead">@NotGivenLead</p>
                        <ul>
                            @foreach (var line in NotGiven)
                            {
                                <li data-testid="order-not-given" lang="@Language">@line</li>
                            }
                        </ul>
                    }
                </details>
            }
        }
        else
        {
            @if (Current.Count > 0)
            {
                <p>You did not say this, so it was assumed:</p>
                <ul>
                    @foreach (var line in Current)
                    {
                        <li data-testid="order-assumption" lang="@Language">@line</li>
                    }
                </ul>
            }
            @if (NotGiven.Count > 0)
            {
                <p data-testid="order-not-given-lead">@NotGivenLead</p>
                <ul>
                    @foreach (var line in NotGiven)
                    {
                        <li data-testid="order-not-given" lang="@Language">@line</li>
                    }
                </ul>
            }
        }
    </section>
}

@code {
    /// <summary>
    /// The delivered result with the assumptions of the clarifier that nobody corrected and those of the writer; assumptions about
    /// facts that the writer got only as "not given by the person" are listed apart, because the text was not written with them. When the
    /// shown version changed an earlier one (<see cref="OrderResult.AssumptionsVersion"/>), the assumptions of the clarifier and the facts not
    /// given are said to be noted for that version, because the change may have settled them, and they are folded behind one line with their
    /// number (<see cref="RevisionLines.EarlierNotesSummary"/>); the assumptions the writer of that version noted stand under
    /// <see cref="RevisionLines.ChangeNotesLead"/>, never under the sentence that the person did not say them. Nothing is left out.
    /// </summary>
    [Parameter, EditorRequired] public OrderResult Result { get; set; } = null!;

    /// <summary>Language of the order (<c>lang</c> of the listed assumptions); <c>null</c> when unknown.</summary>
    [Parameter] public string? Language { get; set; }

    IReadOnlyList<string> Lines => Result.AllAssumptions();

    IReadOnlyList<string> Noted => Result.AssumptionsVersion is null ? [] : Lines.Where(IsClarifiers).ToList();

    IReadOnlyList<string> Current => Result.AssumptionsVersion is null ? Lines : Lines.Where(l => !IsClarifiers(l)).ToList();

    bool IsClarifiers(string line) =>
        (Result.Assumptions ?? []).Any(a => string.Equals(OrderResultRules.SameAssumptionKey(a.Text), OrderResultRules.SameAssumptionKey(line), StringComparison.OrdinalIgnoreCase));

    IReadOnlyList<string> NotGiven => Result.NotGivenFacts();

    /// <summary>The line above facts that were not given; when the text was written with passages looked up on the web it says they may cover one.</summary>
    public const string NotGivenLeadWithoutLookedUp = "You did not give these facts, so they were left open instead of assumed:";

    string NotGivenLead => (Result.AssumptionsVersion, Result.UsedLookedUp()) switch
    {
        (int noted, true) => string.Format(CultureInfo.InvariantCulture, RevisionLines.NotGivenNotedLeadLookedUpFormat, noted),
        (int noted, false) => string.Format(CultureInfo.InvariantCulture, RevisionLines.NotGivenNotedLeadFormat, noted),
        (null, true) => OrderResearchLines.NotGivenLeadLookedUp,
        _ => NotGivenLeadWithoutLookedUp,
    };
}
