@using Geef.Atelier.Application.Orders
@using Geef.Atelier.Core.Domain.FactCheck
@using Geef.Atelier.Core.Domain.Reports

@if (HasContent)
{
    <section class="order-block order-open-points" aria-labelledby="order-open-points-title" data-testid="order-open-points">
        <h2 id="order-open-points-title">Open points</h2>
        @if (Result.Placeholders.Count > 0)
        {
            <p>Fill these in before you send the text:</p>
            <ul class="order-placeholders">
                @foreach (var placeholder in Result.Placeholders)
                {
                    <li data-testid="order-placeholder"><code>@placeholder</code></li>
                }
            </ul>
        }
        @if (Result.OpenChecks.Any(c => c.Blocking))
        {
            <p>The text may not yet do everything you asked for:</p>
            <ul class="order-open-checks">
                @foreach (var check in Result.OpenChecks.Where(c => c.Blocking))
                {
                    <li data-testid="order-open-check" data-code="@check.Code">@check.Message</li>
                }
            </ul>
        }
        @if (Result.BlockingPassages(FactFindingKind.Unsupported) is { Count: > 0 } unbacked)
        {
            <p>These passages may not be backed by your request or your files. Please check them:</p>
            <ul class="order-passages" data-testid="order-unbacked">
                @foreach (var passage in unbacked)
                {
                    <li data-testid="order-passage" data-kind="not-backed"><q class="order-quote" lang="@Language">@passage.Quote</q>@FoundIn(passage)</li>
                }
            </ul>
        }
        @if (Result.BlockingPassages(FactFindingKind.Instruction) is { Count: > 0 } against)
        {
            <p>@(against.Any(ProfileHidden) ? "These passages may not follow what was asked for:" : "These passages may not follow what you asked for:")</p>
            <ul class="order-passages" data-testid="order-against-instruction">
                @foreach (var passage in against)
                {
                    <li data-testid="order-passage" data-kind="against-instruction">
                        <q class="order-quote" lang="@Language">@passage.Quote</q>
                        @if (passage.Origin == InstructionOrigin.Memory)
                        {
                            @if (!string.IsNullOrWhiteSpace(passage.Instruction))
                            {
                                <span class="order-passage-asked" data-origin="about-me">Your About me details say: “<span lang="@Language">@passage.Instruction</span>”</span>
                            }
                            else
                            {
                                <span class="order-passage-asked" data-origin="about-me">This may go against the About me details of the person who ordered the text; they are hidden here.</span>
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(passage.Instruction))
                        {
                            <span class="order-passage-asked">You asked: “<span lang="@Language">@passage.Instruction</span>”</span>
                        }
                        @FoundIn(passage)
                    </li>
                }
            </ul>
        }
        @if (Result.BlockingPassages(FactFindingKind.Superseded) is { Count: > 0 } replaced)
        {
            <p>This passage uses something your files replace or drop:</p>
            <ul class="order-passages" data-testid="order-replaced">
                @foreach (var passage in replaced)
                {
                    <li data-testid="order-passage" data-kind="replaced-in-files"><q class="order-quote" lang="@Language">@passage.Quote</q>@FoundIn(passage)</li>
                }
            </ul>
        }
        @if (SourceIssues.Count > 0)
        {
            <p>@(Result.UsedLookedUp() ? SourceIssuesLeadWithLookedUp : SourceIssuesLead)</p>
            <ul class="order-source-issues" data-testid="order-source-issues">
                @foreach (var issue in SourceIssues)
                {
                    <li data-testid="order-source-issue">
                        @issue
                        @foreach (var note in Result.NotesOn(issue))
                        {
                            <span class="order-issue-note" data-testid="order-source-issue-note">@WriterNoteLead <span lang="@Language">@note</span></span>
                        }
                    </li>
                }
            </ul>
        }
        @if (WriterOpenPoints.Count > 0 || !string.IsNullOrWhiteSpace(Result.NotesNotShown))
        {
            <p>Still open:</p>
            <ul class="order-writer-open" data-testid="order-writer-open">
                @foreach (var point in WriterOpenPoints)
                {
                    <li data-testid="order-writer-open-point" lang="@Language">@point</li>
                }
                @if (!string.IsNullOrWhiteSpace(Result.NotesNotShown))
                {
                    <li data-testid="order-notes-not-shown">@Result.NotesNotShown</li>
                }
            </ul>
        }
        @if (EarlierPoints.Count > 0)
        {
            <details class="order-earlier" data-testid="order-earlier-details">
                <summary>@RevisionLines.EarlierNotesSummary(EarlierPoints.Count, EarlierPoints.Select(p => p.Version))</summary>
                @foreach (var earlier in EarlierPoints.Where(p => p.Kind != EarlierPointKind.Note).GroupBy(p => p.Version))
                {
                    <p data-testid="order-earlier-lead">@string.Format(System.Globalization.CultureInfo.InvariantCulture, RevisionLines.EarlierPointsLeadFormat, earlier.Key)</p>
                    <ul class="order-writer-open" data-testid="order-earlier-points" data-version="@earlier.Key">
                        @foreach (var point in earlier)
                        {
                            <li data-testid="order-earlier-point" data-kind="@(point.Kind == EarlierPointKind.Assumption ? "assumption" : "open-point")">@if (point.Kind == EarlierPointKind.Assumption)
                                {
                                    <span class="order-earlier-kind">@RevisionLines.EarlierAssumptionLead</span>
                                }<span lang="@Language">@point.Text</span></li>
                        }
                    </ul>
                }
                @foreach (var earlier in EarlierPoints.Where(p => p.Kind == EarlierPointKind.Note).GroupBy(p => p.Version))
                {
                    <p data-testid="order-earlier-notes-lead">@string.Format(System.Globalization.CultureInfo.InvariantCulture, RevisionLines.EarlierNotesLeadFormat, earlier.Key)</p>
                    <ul class="order-writer-open" data-testid="order-earlier-notes" data-version="@earlier.Key">
                        @foreach (var point in earlier)
                        {
                            <li data-testid="order-earlier-point" data-kind="note">@point.Text</li>
                        }
                    </ul>
                }
            </details>
        }
        @if (Result.OpenChecks.Any(c => !c.Blocking) || Hints.Count > 0)
        {
            <p>Please also look at this:</p>
            <ul class="order-hints">
                @foreach (var check in Result.OpenChecks.Where(c => !c.Blocking))
                {
                    <li data-testid="order-hint" data-code="@check.Code">@check.Message</li>
                }
                @foreach (var passage in Hints)
                {
                    <li data-testid="order-hint" data-kind="@KindKey(passage)">
                        <q class="order-quote" lang="@Language">@passage.Quote</q>
                        @if (passage.LookedUp)
                        {
                            <span class="order-passage-asked" data-testid="order-hint-looked-up">@OrderResearchLines.DiffersFromLookedUp</span>
                        }
                        else if (passage.Kind == FactFindingKind.Instruction && passage.Origin == InstructionOrigin.Memory)
                        {
                            @if (!string.IsNullOrWhiteSpace(passage.Instruction))
                            {
                                <span class="order-passage-asked" data-origin="about-me">Your About me details say: “<span lang="@Language">@passage.Instruction</span>”</span>
                            }
                            else
                            {
                                <span class="order-passage-asked" data-origin="about-me">This may go against the About me details of the person who ordered the text; they are hidden here.</span>
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(passage.Instruction))
                        {
                            <span class="order-passage-asked">Asked for: “<span lang="@Language">@passage.Instruction</span>”</span>
                        }
                        @if (passage.BeforeLastChange)
                        {
                            <span class="order-passage-asked" data-testid="order-passage-before-change">@RevisionLines.BeforeLastChangeNote</span>
                        }
                        @FoundIn(passage)
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    /// <summary>
    /// The delivered result with placeholders, open checks, passages of the text that may not be backed or may not follow an
    /// instruction, problems in the files, open points of the writer, open points and assumptions (<see cref="RevisionLines.EarlierAssumptionLead"/>)
    /// of the writer for an earlier version that the shown version does not repeat (<see cref="RevisionLines.EarlierPointsLeadFormat"/>), the fixed
    /// sentences of Atelier about an earlier version under their own neutral lead (<see cref="RevisionLines.EarlierNotesLeadFormat"/>) and hints
    /// (everything that never blocks, among them passages the pages looked up say otherwise, with <see cref="OrderResearchLines.DiffersFromLookedUp"/>,
    /// and passages against an instruction from before the latest change, with <see cref="RevisionLines.BeforeLastChangeNote"/>). A passage carried
    /// over from an earlier version names that version (<see cref="FoundInFormat"/>). The notes about earlier versions are folded behind one line
    /// with their number (<see cref="RevisionLines.EarlierNotesSummary"/>); nothing of them is left out.
    /// </summary>
    [Parameter, EditorRequired] public OrderResult Result { get; set; } = null!;

    /// <summary>Language of the order (<c>lang</c> of quoted passages and of the writer's open points); <c>null</c> when unknown.</summary>
    [Parameter] public string? Language { get; set; }

    IReadOnlyList<OrderUnbackedPassage> Hints => Result.HintPassages();

    IReadOnlyList<OrderEarlierPoint> EarlierPoints => Result.ShownEarlierPoints();

    IReadOnlyList<string> SourceIssues => Result.SourceIssues.Shown() ?? [];

    IReadOnlyList<string> WriterOpenPoints => Result.WriterOpenPointsOnTheirOwn();

    /// <summary>Lead of the problems in the material when the text was written without the pages looked up.</summary>
    public const string SourceIssuesLead = "Please check these figures and statements in what you gave:";

    /// <summary>Lead of the problems in the material when the pages looked up were part of it; each sentence names where it stands.</summary>
    public const string SourceIssuesLeadWithLookedUp = "Please check these figures and statements:";

    /// <summary>Words before an open point of the writer shown with the sentence about the same wrong total.</summary>
    public const string WriterNoteLead = "The writer noted:";

    /// <summary>Note on a passage carried over from an earlier version: <c>{0}</c> is that version.</summary>
    public const string FoundInFormat = "Found in version {0}.";

    bool HasContent => Result.HasOpenPoints();

    static RenderFragment? FoundIn(OrderUnbackedPassage passage) => passage.FromVersion is int version
        ? @<span class="order-passage-from" data-testid="order-passage-from">@string.Format(System.Globalization.CultureInfo.InvariantCulture, FoundInFormat, version)</span>
        : null;

    static bool ProfileHidden(OrderUnbackedPassage passage) => passage.Origin == InstructionOrigin.Memory && string.IsNullOrWhiteSpace(passage.Instruction);

    static string KindKey(OrderUnbackedPassage passage) => passage.LookedUp ? "differs-from-looked-up" : KindKey(passage.Kind);

    static string KindKey(FactFindingKind kind) => kind switch
    {
        FactFindingKind.Unsupported => "not-backed",
        FactFindingKind.Instruction => "against-instruction",
        FactFindingKind.Superseded => "replaced-in-files",
        _ => "other",
    };
}
