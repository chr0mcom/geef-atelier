<nav class="lp-nav" aria-label="Main">
    <a class="brand" href="/" aria-label="Geef.Atelier, start page">
        <div class="crest" aria-hidden="true"></div>
        <div class="wordmark" aria-hidden="true">
            <span>geef</span><span class="dot">.</span><span class="atelier">atelier</span>
        </div>
    </a>
    <div class="midnav">
        <a href="/how-it-works" data-enhance-nav="false" data-testid="landing-how-it-works">How it works</a>
        <a href="/#for-whom" data-testid="landing-nav-for-whom">Who it is for</a>
        <a href="/#teams" data-testid="landing-nav-teams">For teams</a>
        <a href="/self-host">Host it yourself</a>
    </div>
    <div class="actions">
        @if (_signedIn)
        {
            <a class="signin" href="/work" data-testid="landing-nav-my-work">My work</a>
            <a class="lp-cta" href="/start" data-testid="landing-nav-start">Write something</a>
        }
        else
        {
            <a class="signin" href="/login" data-testid="landing-nav-sign-in">Sign in</a>
            <a class="lp-cta" href="/login" data-testid="landing-nav-enter">Enter the Atelier</a>
        }
    </div>
</nav>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    bool _signedIn;

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        _signedIn = user?.Identity?.IsAuthenticated == true;
    }
}
