@switch (Name)
{
    case "HeroPress":
        <svg class="press-anim" aria-hidden="true" focusable="false" viewBox="0 0 560 620" width="100%" height="100%" fill="none" stroke="var(--ink-2)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="40" y1="540" x2="520" y2="540" stroke="var(--hairline-strong)" />
            <ellipse cx="280" cy="300" rx="220" ry="200" fill="var(--hero-soft)" stroke="none" />
            <g class="paper-in" transform="translate(218 70)">
                <rect x="0" y="0" width="124" height="76" rx="1" fill="var(--paper)" stroke="var(--paper-rule)" />
                <line x1="14" y1="18" x2="100" y2="18" stroke="var(--paper-ink-2)" stroke-width="0.8" opacity="0.7" />
                <line x1="14" y1="28" x2="86" y2="28" stroke="var(--paper-ink-2)" stroke-width="0.8" opacity="0.7" />
                <line x1="14" y1="38" x2="92" y2="38" stroke="var(--paper-ink-2)" stroke-width="0.8" opacity="0.7" />
                <line x1="14" y1="48" x2="72" y2="48" stroke="var(--paper-ink-2)" stroke-width="0.8" opacity="0.7" />
                <text x="62" y="68" font-family="JetBrains Mono" font-size="7" letter-spacing="0.16em" text-anchor="middle" fill="var(--paper-ink-2)" stroke="none">REQUEST</text>
            </g>
            <line x1="100" y1="170" x2="100" y2="540" />
            <line x1="460" y1="170" x2="460" y2="540" />
            <line x1="80" y1="170" x2="480" y2="170" />
            <line x1="80" y1="180" x2="480" y2="180" stroke="var(--hairline)" />
            <text x="280" y="158" font-family="Newsreader" font-style="italic" font-size="18" text-anchor="middle" fill="var(--ink-2)" stroke="none" letter-spacing="0.05em">geef · atelier</text>
            <g class="platen" transform="translate(0 0)">
                <rect x="120" y="210" width="320" height="78" rx="2" stroke="var(--ink-2)" fill="var(--surface-2)" />
                <line x1="140" y1="226" x2="420" y2="226" stroke="var(--hairline)" />
                <line x1="140" y1="240" x2="420" y2="240" stroke="var(--hairline)" />
                <line x1="140" y1="254" x2="420" y2="254" stroke="var(--hairline)" />
                <line x1="140" y1="268" x2="420" y2="268" stroke="var(--hairline)" />
                <line x1="440" y1="246" x2="510" y2="200" />
                <circle cx="510" cy="200" r="6" fill="var(--surface)" />
                <circle cx="510" cy="200" r="2" fill="var(--hero)" stroke="none" />
                <rect class="stamp-glow" x="160" y="288" width="240" height="10" fill="var(--hero)" stroke="none" opacity="0" />
            </g>
            <rect x="140" y="300" width="280" height="160" rx="1" fill="var(--paper)" stroke="var(--paper-rule)" />
            <g stroke="none" fill="var(--paper-ink-2)" opacity="0.7">
                <text x="160" y="324" font-family="JetBrains Mono" font-size="7" letter-spacing="0.22em" fill="var(--paper-ink-2)">YOUR TEXT</text>
                <text x="160" y="346" font-family="Newsreader" font-style="italic" font-size="14" fill="var(--paper-ink)">Dear [name],</text>
            </g>
            <g stroke="var(--paper-ink-2)" stroke-width="0.8" opacity="0.5">
                <line x1="160" y1="360" x2="400" y2="360" />
                <line x1="160" y1="372" x2="376" y2="372" />
                <line x1="160" y1="384" x2="396" y2="384" />
                <line x1="160" y1="396" x2="352" y2="396" />
                <line x1="160" y1="408" x2="388" y2="408" />
                <line x1="160" y1="420" x2="328" y2="420" />
                <line x1="160" y1="432" x2="384" y2="432" />
                <line x1="160" y1="444" x2="304" y2="444" />
            </g>
            <g transform="translate(60 280)">
                <line x1="0" y1="0" x2="0" y2="160" />
                <line x1="20" y1="0" x2="20" y2="160" />
                <ellipse cx="10" cy="20" rx="14" ry="6" stroke="var(--ink-2)" fill="var(--surface-2)" />
                <ellipse cx="10" cy="80" rx="14" ry="6" stroke="var(--ink-2)" fill="var(--surface-2)" />
                <ellipse cx="10" cy="140" rx="14" ry="6" stroke="var(--ink-2)" fill="var(--surface-2)" />
            </g>
            <line x1="60" y1="480" x2="500" y2="480" />
            <line x1="60" y1="520" x2="500" y2="520" />
            <line x1="80" y1="480" x2="80" y2="520" />
            <line x1="280" y1="480" x2="280" y2="520" />
            <line x1="480" y1="480" x2="480" y2="520" />
            <g class="paper-out" transform="translate(370 470)">
                <rect x="0" y="0" width="100" height="64" rx="1" fill="var(--paper)" stroke="var(--paper-rule)" />
                <line x1="10" y1="12" x2="86" y2="12" stroke="var(--paper-ink-2)" stroke-width="0.8" opacity="0.7" />
                <line x1="10" y1="20" x2="72" y2="20" stroke="var(--paper-ink-2)" stroke-width="0.8" opacity="0.7" />
                <line x1="10" y1="28" x2="80" y2="28" stroke="var(--paper-ink-2)" stroke-width="0.8" opacity="0.7" />
                <line x1="10" y1="36" x2="60" y2="36" stroke="var(--paper-ink-2)" stroke-width="0.8" opacity="0.7" />
                <circle cx="78" cy="48" r="8" fill="var(--hero)" stroke="none" />
                <circle cx="78" cy="48" r="5" fill="none" stroke="var(--on-hero)" stroke-dasharray="1 2" />
            </g>
            <g font-family="JetBrains Mono" font-size="8" letter-spacing="0.22em" text-anchor="middle" fill="var(--ink-3)" stroke="none">
                <text x="100" y="556">ASK</text>
                <text x="220" y="556">WRITE</text>
                <text x="340" y="556">CHECK</text>
                <text x="460" y="556">READ</text>
                <line x1="128" y1="552" x2="186" y2="552" stroke="var(--hairline)" />
                <line x1="254" y1="552" x2="306" y2="552" stroke="var(--hairline)" />
                <line x1="374" y1="552" x2="436" y2="552" stroke="var(--hairline)" />
            </g>
        </svg>
        break;

    case "StepRetry":
        <svg viewBox="0 0 400 80" preserveAspectRatio="none" overflow="visible" aria-hidden="true" focusable="false">
            <defs>
                <marker id="lp-retry-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                    <path d="M0,0 L10,5 L0,10 z" fill="var(--hero)" />
                </marker>
            </defs>
            <path class="retry-path" d="M 394 74 C 320 4, 80 4, 6 74" marker-end="url(#lp-retry-arrow)" />
        </svg>
        break;

    case "StepAsk":
        <svg width="100%" height="100%" viewBox="0 0 96 72" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="12" y="16" width="38" height="46" rx="1" transform="rotate(-5 31 39)" opacity="0.6" />
            <path d="M44 10h34a4 4 0 0 1 4 4v22a4 4 0 0 1 -4 4H58l-10 9v-9h-4a4 4 0 0 1 -4 -4V14a4 4 0 0 1 4 -4z" />
            <path d="M48 20h26 M48 27h20" opacity="0.55" />
            <path d="M48 33h12" stroke="var(--hero)" />
        </svg>
        break;

    case "StepQuestions":
        <svg width="100%" height="100%" viewBox="0 0 96 72" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="16" y="10" width="60" height="52" rx="2" />
            <path d="M42 22a6 6 0 1 1 8 5.6c-1.4 .6 -2 1.6 -2 3v1.4" />
            <circle cx="48" cy="37" r="0.9" fill="currentColor" stroke="none" />
            <rect x="24" y="44" width="18" height="9" rx="4.5" />
            <rect x="46" y="44" width="22" height="9" rx="4.5" stroke="var(--hero)" />
        </svg>
        break;

    case "PhaseExecution":
        <svg width="100%" height="100%" viewBox="0 0 96 72" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="14" y="14" width="50" height="50" rx="1" />
            <path d="M22 24h34 M22 32h28 M22 40h32 M22 48l14 0" opacity="0.55" />
            <path d="M22 56h16" stroke="var(--hero)" />
            <g transform="translate(46 -6) rotate(28 36 40)">
                <path d="M30 38l30 -24" />
                <path d="M30 38l5 -2 l-2 5 z" />
                <path d="M58 16l5 -3" />
            </g>
        </svg>
        break;

    case "StepCheck":
        <svg width="100%" height="100%" viewBox="0 0 96 72" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="20" y="8" width="44" height="56" rx="1" />
            <path d="M28 20l3 3 5 -6 M28 32l3 3 5 -6 M28 44l3 3 5 -6" stroke="var(--hero)" />
            <path d="M42 20h14 M42 32h12 M42 44h14" opacity="0.55" />
            <circle cx="66" cy="50" r="9" />
            <path d="M72.5 56.5l7 7" />
        </svg>
        break;

    case "PhaseFinalize":
        <svg width="100%" height="100%" viewBox="0 0 96 72" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="18" y="10" width="44" height="54" rx="1" />
            <path d="M26 18h28 M26 24h22 M26 30h26 M26 36h20 M26 42h24" opacity="0.55" />
            <circle cx="68" cy="44" r="11" stroke="var(--hero)" />
            <circle cx="68" cy="44" r="7" stroke="var(--hero)" stroke-dasharray="2 2" />
            <path d="M65 41l3 6 4 -8" stroke="var(--hero)" />
            <path d="M52 10l10 10h-10z" opacity="0.4" />
        </svg>
        break;

    case "CapFiles":
        <svg width="100%" height="100%" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="8" y="9" width="16" height="21" rx="1" opacity="0.6" />
            <rect x="12" y="6" width="16" height="21" rx="1" />
            <path d="M16 12h8 M16 16h8 M16 20h5" opacity="0.7" />
        </svg>
        break;

    case "CapQuestions":
        <svg width="100%" height="100%" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M8 7h20a2 2 0 0 1 2 2v13a2 2 0 0 1 -2 2H17l-6 5v-5H8a2 2 0 0 1 -2 -2V9a2 2 0 0 1 2 -2z" />
            <path d="M15.5 12.5a2.5 2.5 0 1 1 3.4 2.3c-.6 .3 -.9 .7 -.9 1.4v.6" />
            <circle cx="18" cy="19.5" r="0.6" fill="currentColor" stroke="none" />
        </svg>
        break;

    case "CapGaps":
        <svg width="100%" height="100%" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M11 9H8v18h3 M25 9h3v18h-3" />
            <path d="M13 18h10" stroke-dasharray="2 2" />
        </svg>
        break;

    case "CapChecked":
        <svg width="100%" height="100%" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="8" y="6" width="20" height="25" rx="1" />
            <path d="M12 13l2 2 3 -4 M12 21l2 2 3 -4" />
            <path d="M20 13h4 M20 21h4" opacity="0.7" />
        </svg>
        break;

    case "CapVersions":
        <svg width="100%" height="100%" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="6" y="12" width="14" height="18" rx="1" opacity="0.55" />
            <rect x="16" y="6" width="14" height="18" rx="1" />
            <path d="M19 12h8 M19 16h6" opacity="0.7" />
            <path d="M10 8c2 -3 5 -4 8 -3" />
            <path d="M16.5 3.5l1.8 1.6 -1.6 1.8" />
        </svg>
        break;

    case "CapExport":
        <svg width="100%" height="100%" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="6" width="18" height="24" rx="1" />
            <path d="M14 14h8 M14 19h8 M14 24h6" opacity="0.7" />
            <path d="M22 4l4 4 M26 4l-4 4" />
        </svg>
        break;

}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
