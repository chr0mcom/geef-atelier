<section class="lp-section intro lp-hero" aria-labelledby="lp-hero-title" data-testid="landing-hero">
    <div class="lede-col">
        <p class="colophon-row">
            <span class="pip" aria-hidden="true"></span>
            <span>A manufactory for the written word</span>
        </p>
        <h1 id="lp-hero-title">A finished text, <br /><em>and what you still need to check.</em></h1>
        <p class="sub" data-testid="landing-hero-sub">
            Say in your own words what you need: a letter, an email, a notice, a summary. Add files if you have them.
            @if (Features.Questions)
            {
                <text>Atelier may ask up to @Features.MaxQuestions quick questions first. Then it writes the text, checks what it can and lists what is still open.</text>
            }
            else
            {
                <text>Atelier writes the text, checks what it can and lists what is still open and what it assumed.</text>
            }
            You decide what to send.
        </p>
        <div class="hero-actions">
            @if (Features.ForSignedInPerson)
            {
                <a class="lp-cta lg" href="/start" data-testid="landing-hero-start">Write something</a>
            }
            else
            {
                <a class="lp-cta lg" href="/login" data-testid="landing-hero-start">Enter the Atelier</a>
            }
            <a class="lp-cta lg ghost" href="/how-it-works" data-enhance-nav="false" data-testid="landing-hero-how">See how it works</a>
        </div>
        @if (!Features.ForSignedInPerson)
        {
            <p class="hero-account" data-testid="landing-hero-account">You need an account. The administrators of this Atelier set them up.</p>
        }
        <dl class="hero-meta">
            <div class="item">
                <dt>Good for</dt>
                <dd class="v">letters, emails, notices, summaries, reports</dd>
            </div>
            <div class="item">
                <dt>Your files</dt>
                <dd class="v">PDF, Word or text, up to @Features.MaxFiles per request</dd>
            </div>
            <div class="item">
                <dt>Open</dt>
                <dd class="v">open source, you can host it yourself</dd>
            </div>
        </dl>
    </div>

    <div class="hero-visual" aria-hidden="true">
        <div class="frame">
            <div class="colophon">
                <span>Folio I</span>
                <span><b>Press at work</b></span>
            </div>
            <LandingIllustrations Name="HeroPress" />
            <div class="stage-floor"></div>
        </div>
    </div>
</section>

@code {
    /// <summary>What the start page may call available for the viewer.</summary>
    [Parameter, EditorRequired] public HowItWorksFeatures Features { get; set; } = null!;
}
