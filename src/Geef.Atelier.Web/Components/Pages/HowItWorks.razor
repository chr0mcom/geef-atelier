@page "/how-it-works"
@attribute [AllowAnonymous]
@using Geef.Atelier.Application.Orders
@using Geef.Atelier.Core.Configuration
@using Geef.Atelier.Web.Components.UI.Orders
@using Geef.Atelier.Web.Notifications
@using Microsoft.Extensions.Options
@inject IOptions<OrderOptions> OrderSettings
@inject IOptions<IntakeOptions> IntakeSettings
@inject IOptions<ResearchOptions> ResearchSettings
@inject IOptions<DirectOptions> DirectSettings
@inject IOptions<UploadOptions> UploadSettings
@inject IOptions<UiOptions> UiSettings
@inject IOptions<McpOptions> McpSettings
@inject IOptions<SourceOptions> SourceSettings
@inject NavigationManager Nav

<PageTitle>How it works — Atelier</PageTitle>
<HeadContent>
    <meta name="description" content="How Atelier turns a short request into a finished text: what it asks, what it checks, what it leaves open, and what it does not do." />
</HeadContent>

<div class="hiw" data-testid="how-it-works">
    <header class="hiw-head">
        <h1 class="hiw-title">How Atelier works</h1>
        <p class="hiw-lead">You say what you need. Atelier writes it, checks what it can and tells you what is still open. You decide what to send.</p>
        <p class="hiw-cta">
            @if (_f.ForSignedInPerson)
            {
                <a class="btn primary" href="/start" data-testid="hiw-start">Write something</a>
            }
            else
            {
                <a class="btn primary" href="/login" data-testid="hiw-sign-in">Sign in to start</a>
            }
        </p>
    </header>

    <nav class="hiw-ways" aria-labelledby="hiw-ways-title" data-testid="hiw-ways">
        <h2 id="hiw-ways-title" class="hiw-h2">Start where you are</h2>
        <ul class="hiw-ways-list">
            <li><a href="#steps" data-testid="hiw-way-everyone"><strong>I just want a text</strong><span>The steps, an example and what the checks mean.</span></a></li>
            <li><a href="#assistant" data-testid="hiw-way-assistant"><strong>I use an AI assistant</strong><span>Use Atelier from Claude Code or another assistant.</span></a></li>
            <li><a href="#admins" data-testid="hiw-way-admins"><strong>I manage Atelier for a team</strong><span>People and settings.</span></a></li>
            <li><a href="#developers" data-testid="hiw-way-developers"><strong>I build or host it</strong><span>Code, documentation and decisions.</span></a></li>
        </ul>
    </nav>

    <section class="hiw-section" id="steps" aria-labelledby="hiw-steps-title" data-testid="hiw-steps">
        <h2 id="hiw-steps-title" class="hiw-h2">The steps</h2>
        <ol class="hiw-thread">
            <li class="hiw-step" data-testid="hiw-step" data-step="ask">
                <span class="hiw-step-mark" aria-hidden="true">1</span>
                <div class="hiw-step-body">
                    <h3>You ask</h3>
                    <p>Write in one or two sentences what you need, in your own words. You can add up to @_f.MaxFiles files: PDF, Word or text.</p>
                </div>
            </li>
            <li class="hiw-step" data-testid="hiw-step" data-step="@(_f.Questions ? "questions" : "no-questions")">
                <span class="hiw-step-mark" aria-hidden="true">2</span>
                <div class="hiw-step-body">
                    @if (_f.Questions)
                    {
                        <h3>It may ask back</h3>
                        <p>If something important is missing, you get up to @_f.MaxQuestions short questions with answers to click. You can skip them. Anything else it has to guess is written down as an assumption.</p>
                    }
                    else
                    {
                        <h3>It starts right away</h3>
                        <p>It does not ask questions first. What it has to guess is written down as an assumption.</p>
                    }
                </div>
            </li>
            <li class="hiw-step" data-testid="hiw-step" data-step="write">
                <span class="hiw-step-mark" aria-hidden="true">3</span>
                <div class="hiw-step-body">
                    <h3>It writes</h3>
                    <p>An AI writer drafts the text from your request, your answers, your <a href="#about-me">About me</a> details and your files. Where a fact is missing, it is asked to leave a gap in [square brackets] instead of making something up.</p>
                    @if (_f.WebResearch)
                    {
                        <p data-testid="hiw-step-research">If your request has gaps that can be looked up on the web, it may look them up first. It never does this when you add files. The result shows which search words were sent, what was looked up and on which page. A change of a finished text uses what was looked up the first time and does not search again. There is a daily limit for looking things up; once it is reached, the text is written without it, and the result says so.</p>
                    }
                </div>
            </li>
            <li class="hiw-step" data-testid="hiw-step" data-step="check">
                <span class="hiw-step-mark" aria-hidden="true">4</span>
                <div class="hiw-step-body">
                    <h3>It checks</h3>
                    <p>Automatic checks look for certain problems, such as the wrong length or language, or gaps left in the text. If one finds a clear problem, the writer gets one more try.</p>
                    <p data-testid="hiw-step-factcheck">@FactCheckSentence</p>
                </div>
            </li>
            <li class="hiw-step" data-testid="hiw-step" data-step="result">
                <span class="hiw-step-mark" aria-hidden="true">5</span>
                <div class="hiw-step-body">
                    <h3>You get the text</h3>
                    <p>The text comes first. Right below it: what was checked, then what you still need to fill in or look at, and what was assumed. Download it as Word, PDF or Markdown.</p>
                    @if (_f.ChangeText)
                    {
                        <p data-testid="hiw-step-change">Not quite right? Use “@RevisionLines.ChangeButton” and say in your own words what to change. Atelier writes a new version and keeps the earlier ones (up to @_f.MaxVersions versions). Read the new version: if it is much longer, a note above the text asks you to check the new parts.</p>
                    }
                    <p data-testid="hiw-step-time">This can take from less than a minute to several minutes. You can leave the page; the text waits for you under My work.</p>
                </div>
            </li>
        </ol>
    </section>

    <section class="hiw-section" id="example" aria-labelledby="hiw-example-title" data-testid="hiw-example">
        <h2 id="hiw-example-title" class="hiw-h2">An example</h2>
        <p class="hiw-note">This example is made up to show the steps. A real result depends on your request.</p>

        <div class="hiw-sheet">
            <div class="hiw-sheet-part">
                <p class="hiw-sheet-label">The request</p>
                <blockquote class="hiw-quote">Write a short note for the notice board in our building: we are having a party in the courtyard on Saturday afternoon. Everyone is welcome.</blockquote>
            </div>

            @if (_f.Questions)
            {
                <div class="hiw-sheet-part" data-testid="hiw-example-question">
                    <p class="hiw-sheet-label">One question before it starts</p>
                    <p class="hiw-question">What time does the party start?</p>
                    <ul class="hiw-options" aria-label="Answers to click (example)">
                        <li>3 pm</li>
                        <li>4 pm</li>
                        <li class="is-chosen is-skip"><span class="visually-hidden">Chosen: </span>Skip</li>
                    </ul>
                </div>
            }

            <div class="hiw-sheet-part">
                <p class="hiw-sheet-label">Your text</p>
                <div class="hiw-letter">
                    <p>Dear neighbours,</p>
                    <p>this Saturday from <mark>[start time]</mark> we are having a party in the courtyard, and you are all warmly invited. <span class="hiw-flag">We will take care of the grill.</span></p>
                    <p>If you have questions, ring at <mark>[your flat number]</mark>.</p>
                    <p><span class="@(_f.FactCheck == FactCheckOffer.NotShown ? "" : "hiw-flag hiw-flag--harmless")">See you on Saturday!</span><br /><mark>[Your name]</mark></p>
                </div>
            </div>

            <div class="hiw-sheet-part hiw-sheet-part--checks" data-testid="hiw-example-checks">
                <p class="hiw-sheet-label">@OrderCheckLines.Heading</p>
                <ul>
                    <li>@ExampleAutomaticLine</li>
                    <li>@ExampleFactLine</li>
                </ul>
                <p>@(_f.FactCheck == FactCheckOffer.NotShown ? OrderCheckLines.ToReviewFactsNotFullyChecked : OrderCheckLines.ToReviewOpenPoints)</p>
                <p class="hiw-limits">@OrderCheckLines.Limits</p>
            </div>

            <div class="hiw-sheet-part hiw-sheet-part--notes">
                <p class="hiw-sheet-label">Open points</p>
                <p>@FillInLead <mark>[start time]</mark>, <mark>[your flat number]</mark>, <mark>[Your name]</mark></p>
                @if (_f.FactCheck != FactCheckOffer.NotShown)
                {
                    <p data-testid="hiw-example-unbacked">@UnbackedLead <span class="hiw-flag">“We will take care of the grill.”</span> <span class="hiw-flag hiw-flag--harmless">“See you on Saturday!”</span></p>
                }
                <p class="hiw-sheet-label">Assumptions</p>
                <p>@AssumedLead the note is friendly and informal.</p>
            </div>
        </div>
        @if (_f.FactCheck != FactCheckOffer.NotShown)
        {
            <p class="hiw-note" data-testid="hiw-example-explained">The person skipped the question, so the start time stays a gap to fill in. The writer added a sentence nobody asked for (“We will take care of the grill.”), and the fact check pointed it out. It also pointed at “See you on Saturday!”, which is harmless. That is typical: read the open points, they are not all problems.</p>
        }
        else
        {
            <p class="hiw-note" data-testid="hiw-example-explained">The person skipped the question, so the start time stays a gap to fill in. The writer added a sentence nobody asked for (“We will take care of the grill.”). Read every text before you send it.</p>
        }
    </section>

    <section class="hiw-section" id="why" aria-labelledby="hiw-why-title" data-testid="hiw-why">
        <h2 id="hiw-why-title" class="hiw-h2">What Atelier does around the writing</h2>
        <div class="hiw-columns">
            <div>
                <h3>What it adds</h3>
                <ul class="hiw-list hiw-list--plus">
                    <li data-testid="hiw-why-files"><strong>The writer gets your whole file.</strong> Up to @_f.FullTextChars.Grouped() characters (roughly @ApproxPages(_f.FullTextChars) pages) nothing is cut off or shortened first. If the writer seems to have read only parts, the result says so.</li>
                    @if (_f.Questions)
                    {
                        <li><strong>It asks before it starts, not afterwards.</strong> It is built to ask only what changes the result, with answers to click.</li>
                    }
                    <li><strong>It is built to show what it did not know.</strong> The writer is asked to leave gaps as [square brackets], and guesses are listed as assumptions.</li>
                    <li><strong>It says what was checked, and what was not.</strong> It never claims that the text is right.</li>
                    <li><strong>It knows who you are.</strong> What you write once under About me goes along with every request.</li>
                    <li><strong>Your texts stay in one place.</strong> Every request, every version and the downloads are under My work.</li>
                </ul>
            </div>
            <div>
                <h3>What it does not do</h3>
                <ul class="hiw-list hiw-list--minus" data-testid="hiw-limits">
                    <li>It can still be wrong. The checks look for certain problems; they do not prove that everything is right.</li>
                    @if (_f.FactCheck != FactCheckOffer.NotShown)
                    {
                        <li>The fact check can miss things. It often points at harmless sentences too, such as a closing line or a signature.</li>
                    }
                    <li>It is not a chat. Once it starts, you wait for the result. You cannot add files to a request later.</li>
                    <li data-testid="hiw-limit-learning">It does not learn from your earlier texts. Only your About me details carry over.</li>
                    <li>Scanned pages (photos of paper) cannot be read.</li>
                </ul>
            </div>
        </div>
    </section>

    <section class="hiw-section" id="status" aria-labelledby="hiw-status-title" data-testid="hiw-status">
        <h2 id="hiw-status-title" class="hiw-h2">What is switched on right now</h2>
        <p class="hiw-note" data-testid="hiw-status-scope">
            @(_f.ForSignedInPerson
                ? "This list shows what you can use. It follows the current settings of this Atelier."
                : "This list shows the settings for everyone. A signed-in person may have a feature switched on early for testing.")
        </p>
        <dl class="hiw-status">
            <HowItWorksStatusRow Key="questions" Label="Questions before it starts" On="_f.Questions" OnText="On" OffText="Off" />
            <HowItWorksStatusRow Key="change" Label="Changing a finished text" On="_f.ChangeText" OnText="On" OffText="Not switched on yet" />
            <HowItWorksStatusRow Key="research" Label="Looking things up on the web" On="_f.WebResearch" OnText="On" OffText="Not switched on yet" />
            <HowItWorksStatusRow Key="factcheck" Label="Fact check" On="_f.FactCheck != FactCheckOffer.NotShown" OnText="@(_f.FactCheck == FactCheckOffer.MayFixOnce ? "Points things out, may fix some" : "Points things out, changes nothing")" OffText="Not shown" />
            <HowItWorksStatusRow Key="upload" Label="Files from an AI assistant" On="_f.UploadThroughAssistant" OnText="On" OffText="Only very small text files" />
        </dl>
        @if (!_f.ChangeText || !_f.WebResearch)
        {
            <p class="hiw-note">An administrator can switch these features on. This page then shows them here without any further change.</p>
        }
    </section>

    <section class="hiw-section" id="files" aria-labelledby="hiw-files-title" data-testid="hiw-files">
        <h2 id="hiw-files-title" class="hiw-h2">Your files</h2>
        <ul class="hiw-list">
            <li>PDF, Word (.docx), text and Markdown files. Up to @_f.MaxFiles files per request, each up to @Megabytes(_f.MaxFileBytes) MB.</li>
            <li>After you add a file you see a short receipt: what Atelier read, with pages, characters and how well it could be read.</li>
            <li>Up to @_f.FullTextChars.Grouped() characters in all, the writer gets your files completely. Up to @_f.MapChars.Grouped() characters it gets a table of contents and searches the parts that matter. Above that you choose the pages of a PDF to use.</li>
            <li>Your files go to the AI services this Atelier uses to write and check your text. Atelier never puts them into a web search.</li>
            <li data-testid="hiw-files-kept">Atelier keeps your request, your text and what it read from your files until you delete the request under My work. Deleting it also deletes the files that no other request uses. The original file is removed about @((int)SourceSettings.Value.OriginalRetention.TotalDays) days after the last request that used it finished; the text read from it stays with the request.</li>
        </ul>
    </section>

    <section class="hiw-section" id="checks" aria-labelledby="hiw-checks-title" data-testid="hiw-checks">
        <h2 id="hiw-checks-title" class="hiw-h2">What the checks mean</h2>
        <p>Below every text there is a box “@OrderCheckLines.Heading”. It lists only the checks that really ran.</p>
        <dl class="hiw-defs">
            <dt>Checked automatically</dt>
            <dd>Checked without AI. A few basics are always checked: the text is not empty and starts with the text itself, not with a remark to the reader. Length, language, gaps, lists or headings, and words to use or to avoid are checked only when your request asked for them.</dd>
            <dt>Facts</dt>
            <dd data-testid="hiw-checks-facts">@FactCheckDefinition</dd>
            @if (_f.SumsInFiles)
            {
                <dt>Sums in your files</dt>
                <dd data-testid="hiw-checks-sums">Totals in your files are added up again without AI. If one does not match, you see both figures and which one the text uses.</dd>
            }
            <dt>Changed after the check</dt>
            <dd>What a check asked the writer to change is listed here.</dd>
        </dl>
        <p>Every box ends with the same sentence: “@OrderCheckLines.Limits”</p>
    </section>

    <section class="hiw-section" id="about-me" aria-labelledby="hiw-about-title" data-testid="hiw-about">
        <h2 id="hiw-about-title" class="hiw-h2">About me and your privacy</h2>
        <figure class="hiw-flow" data-testid="hiw-flow" aria-labelledby="hiw-flow-caption">
            <div class="hiw-flow-row">
                <div class="hiw-flow-box"><strong>You</strong><span>request, answers, About me, files</span></div>
                <span class="hiw-flow-arrow" aria-hidden="true"></span>
                <div class="hiw-flow-box hiw-flow-box--main"><strong>Atelier</strong><span>keeps your requests</span></div>
                <span class="hiw-flow-arrow" aria-hidden="true"></span>
                <div class="hiw-flow-ends">
                    <div class="hiw-flow-box"><strong>AI services</strong><span>write and check the text</span></div>
                    <div class="hiw-flow-box@(_f.WebResearch ? "" : " hiw-flow-box--off")" data-testid="hiw-flow-search"><strong>Web search</strong><span>@(_f.WebResearch ? "short topics only, never files" : "not switched on")</span></div>
                </div>
            </div>
            <figcaption id="hiw-flow-caption" class="hiw-note">@FlowDescription</figcaption>
        </figure>
        <ul class="hiw-list">
            <li>Under About me you can save your name, how you sign off, how readers are addressed, your language and what never to do. Atelier uses it in every text. Only you can change it.</li>
            @if (_f.TellOnce != TellOnceMode.Off)
            {
                <li data-testid="hiw-about-tell-once">When a text had to guess or leave open your name, how you sign off, how readers are addressed or your language, and About me has nothing on it yet, the result offers a field to save it there, as long as that field is still empty. @TellOnceNext A change of a text you already have keeps the details it was written with. The result also says what the writer got from About me.</li>
            }
            <li>Your request, your answers, your About me details and your files go to the AI services that write and check the text.</li>
            @if (_f.WebResearch)
            {
                <li data-testid="hiw-privacy-research">To look things up, Atelier sends a web search service a few short search words taken from your request, and only when you add no files. @OrderResearchLines.SearchPrivacy</li>
            }
            <li>Only you and the administrators of this Atelier can see your requests. More in the <a href="/privacy">privacy notice</a>.</li>
        </ul>
    </section>

    <section class="hiw-section" id="assistant" aria-labelledby="hiw-assistant-title" data-testid="hiw-assistant">
        <h2 id="hiw-assistant-title" class="hiw-h2">From an AI assistant</h2>
        <p>You can connect Atelier to an AI assistant through MCP, a common way for assistants to use outside tools.</p>
        <p data-testid="hiw-assistant-tested">It is tested with Claude Code, also through a connection set up in claude.ai, with a complete request including a file and a question. Using it from the claude.ai chat window itself and from Claude Desktop has not been tested.</p>
        <ol class="hiw-list hiw-list--numbered">
            <li>In your assistant, add a connector with this address: <code class="hiw-code" data-testid="hiw-mcp-address">@McpAddress</code></li>
            <li>Your assistant opens a sign-in page. Sign in and allow access. From then on the assistant acts as you. If the sign-in page does not open, ask your administrator.</li>
            <li>Ask it, for example: “Have Atelier write a short note for the notice board.”</li>
        </ol>
        <p>Atelier tells the assistant to pass your words on unchanged, to ask you Atelier's questions, to wait and to show you the text together with what was checked and what is open, without filling in gaps itself. Whether it does so depends on the assistant; the full result is always in the web app.</p>
        <ul class="hiw-list">
            @if (_f.UploadThroughAssistant)
            {
                <li data-testid="hiw-assistant-upload">Files: the assistant uploads them for you, or gives you a link to an upload page. The file arrives exactly as it is.</li>
            }
            else
            {
                <li data-testid="hiw-assistant-upload">Files: only very small text files can come from the assistant. For other files, start in the web app.</li>
            }
            @if (_f.ChangeText)
            {
                <li data-testid="hiw-assistant-change">Changes: the assistant can ask for a change in your words. Atelier asks the writer to make only that change; it does not check that nothing else changed.</li>
            }
            @if (_f.TellOnce != TellOnceMode.Off)
            {
                <li data-testid="hiw-assistant-about-me">About me: the assistant can save your name, how you sign off, how readers are addressed and your language when you ask it to, but only where About me has nothing yet. Everything else you change under About me.</li>
            }
            <li>Everything you order through the assistant is also under My work in the web app, with the full result.</li>
            <li>You can see and remove connected assistants under Connected clients in your menu.</li>
        </ul>
        <p><a href="/docs/13-ai-assistant-guide">Guide for AI assistants</a></p>
    </section>

    <section class="hiw-section" id="admins" aria-labelledby="hiw-admins-title" data-testid="hiw-admins">
        <h2 id="hiw-admins-title" class="hiw-h2">For administrators</h2>
        <p>Administrators add people under User management, can see and stop every request and decide which features are on, for everyone or first for single people. This page follows those settings.</p>
        @if (_isAdmin)
        {
            <div class="hiw-table-wrap" role="region" aria-labelledby="hiw-admins-table-caption" tabindex="0" data-testid="hiw-admins-table">
                <table class="hiw-table">
                    <caption id="hiw-admins-table-caption">Settings for everyone (shown to administrators only)</caption>
                    <thead><tr><th scope="col">Feature</th><th scope="col">Setting</th><th scope="col">For everyone now</th></tr></thead>
                    <tbody>
                        <tr><td>Questions before it starts</td><td><code>Orders:IntakeMode</code></td><td>@OrderSettings.Value.IntakeMode</td></tr>
                        <tr><td>Changing a finished text</td><td><code>Orders:Revise</code>, per person <code>Orders:ReviseOverrides</code></td><td>@_everyone.ChangeText.OnOff()</td></tr>
                        <tr><td>Looking things up on the web</td><td><code>Research:Mode</code>, per person <code>Research:ModeOverrides</code></td><td>@_everyone.WebResearch.OnOff()</td></tr>
                        <tr><td>Fact check</td><td><code>Direct:FactCheckMode</code>, per person <code>Direct:FactCheckModeOverrides</code></td><td>@DirectSettings.Value.FactCheckMode</td></tr>
                        <tr><td>Files from an AI assistant</td><td><code>Uploads:Tickets</code></td><td>@_everyone.UploadThroughAssistant.OnOff()</td></tr>
                        <tr><td>Offer to save missing details under About me</td><td><code>Orders:TellOnce</code></td><td>@_everyone.TellOnce</td></tr>
                        <tr><td>Workshop menu only for administrators</td><td><code>Ui:WorkshopForAdminsOnly</code></td><td>@UiSettings.Value.WorkshopForAdminsOnly.OnOff()</td></tr>
                    </tbody>
                </table>
            </div>
            <p data-testid="hiw-admins-workshop">The workshop menu holds a technical list of all writing jobs and, for administrators, the AI providers. @(UiSettings.Value.WorkshopForAdminsOnly ? "It is shown only to administrators." : "It is shown to everyone.") The older way of working with teams you set up yourself no longer exists.</p>
        }
        <p><a href="/docs/14-admin-guide">Guide for administrators</a></p>
    </section>

    <section class="hiw-section" id="developers" aria-labelledby="hiw-dev-title" data-testid="hiw-developers">
        <h2 id="hiw-dev-title" class="hiw-h2">For developers and hosts</h2>
        <p>Atelier is open source. The code, the documentation and the log of every design decision are public.</p>
        <ul class="hiw-list">
            <li><a href="/docs/15-developer-guide">Guide for developers and hosts</a></li>
            <li><a href="/docs/12-user-guide">Guide for everyone</a></li>
            <li><a href="https://github.com/chr0mcom/geef-atelier" rel="noopener">Source code on GitHub</a></li>
        </ul>
    </section>
</div>

@code {
    /// <summary>Lead of the placeholder list, as the result page shows it (<c>OrderOpenPoints.razor</c>).</summary>
    public const string FillInLead = "Fill these in before you send the text:";

    /// <summary>Lead of the passages that may not be backed, as the result page shows it (<c>OrderOpenPoints.razor</c>).</summary>
    public const string UnbackedLead = "These passages may not be backed by your request or your files. Please check them:";

    /// <summary>Lead of the assumptions, as the result page shows it (<c>OrderAssumptions.razor</c>).</summary>
    public const string AssumedLead = "You did not say this, so it was assumed:";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    HowItWorksFeatures _f = null!;
    HowItWorksFeatures _everyone = null!;
    bool _isAdmin;

    HowItWorksSettings Settings => new(OrderSettings.Value, IntakeSettings.Value, ResearchSettings.Value, DirectSettings.Value, UploadSettings.Value,
        UiSettings.Value, McpSettings.Value, SourceSettings.Value);

    string McpAddress => Nav.BaseUri.TrimEnd('/') + "/mcp";

    string TellOnceNext => _f.TellOnce == TellOnceMode.On
        ? "From your next request on, Atelier takes it from About me instead of guessing or asking, and the writer gets it with every new request."
        : "Atelier uses it for your next requests: the writer gets it with every new request.";

    string FlowDescription => _f.WebResearch
        ? "Your request, answers, About me details and files go to Atelier, which passes them to the AI services that write and check the text. A web search service gets only a few short search words taken from your request, never your answers or your files; names or other details you wrote can end up in them."
        : "Your request, answers, About me details and files go to Atelier, which passes them to the AI services that write and check the text. Nothing goes to a web search.";

    string FactCheckSentence => _f.FactCheck switch
    {
        FactCheckOffer.MayFixOnce => "Another AI compares the facts in the text with what you gave and points out passages that may not be backed. Some of them may be fixed once; the rest is shown for you to check.",
        FactCheckOffer.ReportsOnly => "Another AI compares the facts in the text with what you gave and points out passages that may not be backed. It does not change the text.",
        _ => "No fact check is shown for your texts right now.",
    };

    string FactCheckDefinition => _f.FactCheck switch
    {
        FactCheckOffer.MayFixOnce => "Another AI compares the facts in the text with your request, your answers and your files. Passages it cannot find there are listed for you to check. Some may be fixed once; what was changed is listed. With very long files the facts are not compared with the files; the box then says so.",
        FactCheckOffer.ReportsOnly => "Another AI compares the facts in the text with your request, your answers and your files. Passages it cannot find there are listed for you to check. It does not change the text. With very long files the facts are not compared with the files; the box then says so.",
        _ => "No fact check is shown right now: the box then says “" + OrderCheckLines.FactsNotChecked + "”",
    };

    string ExampleAutomaticLine => OrderCheckLines.AutomaticLead + OrderCheckLines.PassedNotEmpty + OrderCheckLines.AutomaticSeparator
        + OrderCheckLines.PassedStartsDirectly + OrderCheckLines.AutomaticEnd;

    string ExampleFactLine => _f.FactCheck == FactCheckOffer.NotShown
        ? OrderCheckLines.FactsNotChecked
        : OrderCheckLines.FactsComparedLeadNoFiles + string.Format(System.Globalization.CultureInfo.InvariantCulture, OrderCheckLines.FactsOpenFormat, 2);

    static int ApproxPages(int chars) => Math.Max(1, (int)Math.Round(chars / 2_500d / 10d) * 10);

    static string Megabytes(long bytes) => (bytes / (1024d * 1024d)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnParametersSetAsync()
    {
        var viewer = AuthState is null ? null : (await AuthState).User;
        _f = Settings.FeaturesFor(viewer);
        _everyone = Settings.FeaturesFor(null);
        _isAdmin = viewer?.Identity?.IsAuthenticated == true && viewer.IsAtelierAdmin();
    }
}
