@page "/self-host"
@layout Layout.LandingLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization

<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
</HeadContent>

<div class="landing" data-testid="self-host">
    <LandingNav />

    <main id="main">
    <section class="lp-section sh" aria-labelledby="sh-title">
        <div class="lp-container">
            <p class="lp-eyebrow">Open source, MIT license</p>
            <h1 class="lp-h2" id="sh-title">Host Atelier on your own server.</h1>
            <p class="lp-lede">
                Atelier is free and open source under the MIT license, like the
                <a class="sh-link" href="https://github.com/chr0mcom/geef" target="_blank" rel="noopener">open Geef SDK</a>
                it is built on. You can host the whole application yourself: the web app, the database with every request and text, and the
                files people add.
            </p>

            <div class="sh-actions">
                <a class="lp-cta lg" href="https://github.com/chr0mcom/geef-atelier" target="_blank" rel="noopener">View the code on GitHub</a>
                <a class="lp-cta lg ghost" href="https://github.com/chr0mcom/geef" target="_blank" rel="noopener">Read about the SDK</a>
            </div>

            <div class="sh-data" data-testid="self-host-data">
                <h2 class="sh-h2">What stays on your server, and what does not</h2>
                <ul class="lp-plain-list">
                    <li data-testid="self-host-stays">On your server: accounts, requests, texts and their versions, the files people add and what was read from them.</li>
                    <li data-testid="self-host-leaves">To write and check a text, Atelier sends the request, the answers, the About me details and the files to the AI services you connect. You choose which ones, and their terms apply.</li>
                    <li>Web searches happen only where an administrator has set them up or switched them on.</li>
                </ul>
            </div>

            <div class="sh-grid">
                <div class="sh-item">
                    <h3>One stack</h3>
                    <p>The web app, a Postgres database, a nightly database backup and a gateway for AI command-line tools, started with one <code>docker compose</code> command. Database changes are applied when the app starts.</p>
                </div>
                <div class="sh-item">
                    <h3>Your AI services</h3>
                    <p>You connect them yourself: with an OpenRouter key, or through the included gateway, which uses AI command-line tools signed in with your own accounts. Administrators can add more.</p>
                </div>
                <div class="sh-item">
                    <h3>People and settings</h3>
                    <p>Accounts with hashed passwords; the first administrator comes from your settings file. Administrators add people and decide which features are on.</p>
                </div>
                <div class="sh-item">
                    <h3>From AI assistants</h3>
                    <p>A built-in MCP server, a common way for AI assistants to use outside tools. People sign in through the browser, or you use a fixed token.</p>
                </div>
                <div class="sh-item">
                    <h3>Explained on every level</h3>
                    <p>Guides for everyone, for administrators and for developers, and the log of every design decision, are in the repository and under <a class="sh-link" href="/docs">Documentation</a>.</p>
                </div>
                <div class="sh-item">
                    <h3>Behind your reverse proxy</h3>
                    <p>A health check at <code>/health</code> tells your reverse proxy or monitor whether the app is up.</p>
                </div>
            </div>

            <div class="sh-quickstart">
                <h2 class="sh-h2">Quick start</h2>
                <pre><code>git clone https://github.com/chr0mcom/geef-atelier
cd geef-atelier
cp .env.example .env        # fill in passwords and keys
docker compose up -d --build</code></pre>
                <p class="sh-note">
                    The README in the repository explains every step: passwords, the first administrator, the AI services, backups and restore.
                    Health check at <code>https://&lt;your-domain&gt;/health</code>.
                </p>
            </div>

            <p class="sh-foot">
                MIT license. Built on .NET 10, Blazor and the open Geef SDK.
                <a href="/">Back to the start page</a>
            </p>
        </div>
    </section>
    </main>

    <LandingFooter />
</div>

@code {
    /// <summary>The title of the page.</summary>
    public const string Title = "Host it yourself — Geef.Atelier";

    /// <summary>The description search engines and link previews show.</summary>
    public const string Description =
        "Atelier is open source under the MIT license. Host it on your own server: requests, texts and files are kept there and go only "
        + "to the AI services you connect.";
}

<style>
    .sh { padding-top: 72px; }
    .sh .lp-h2 { max-width: 22ch; }
    .sh .sh-link { color: var(--hero); text-decoration: none; border-bottom: 1px solid color-mix(in oklch, var(--hero) 40%, transparent); }
    .sh .sh-link:hover { border-bottom-color: var(--hero); }

    .sh-actions {
        display: flex; flex-wrap: wrap; gap: 14px;
        margin: 36px 0 8px;
    }

    .sh-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        margin-top: 56px;
        background: var(--hairline-soft);
        border: 1px solid var(--hairline-soft);
    }
    @@media (max-width: 900px) { .sh-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 600px) { .sh-grid { grid-template-columns: 1fr; } }
    .sh-item {
        background: var(--surface);
        padding: 28px 26px;
    }
    .sh-item h3 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 19px;
        letter-spacing: -0.01em;
        color: var(--ink);
        margin: 0 0 10px;
    }
    .sh-item p {
        font-family: var(--font-ui);
        font-size: 14px;
        line-height: 1.55;
        color: var(--ink-2);
        margin: 0;
    }
    .sh-item code {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--ink);
        background: var(--surface-2);
        padding: 1px 5px;
        border-radius: 4px;
    }

    .sh-quickstart { margin-top: 48px; }
    .sh-h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 24px;
        color: var(--ink);
        margin: 0 0 14px;
    }
    .sh-data { margin-top: 44px; }
    .sh-quickstart pre {
        margin: 14px 0 0;
        background: var(--surface-2);
        border: 1px solid var(--hairline-soft);
        border-radius: 8px;
        padding: 22px 24px;
        overflow-x: auto;
    }
    .sh-quickstart code {
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 1.7;
        color: var(--ink);
        white-space: pre;
    }
    .sh-note {
        font-family: var(--font-ui);
        font-size: 14px;
        color: var(--ink-2);
        margin: 16px 0 0;
        line-height: 1.55;
    }
    .sh-note code {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--ink-2);
    }

    .sh-foot {
        margin-top: 48px;
        padding-top: 24px;
        border-top: 1px solid var(--hairline-soft);
        font-size: 13px;
        color: var(--ink-2);
    }
    .sh-foot a { color: var(--hero); margin-left: 12px; }
    .sh-foot a:hover { color: var(--hero); }
</style>
