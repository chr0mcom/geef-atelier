@page "/orders/{orderId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable
@using Geef.Atelier.Application.Orders
@using Geef.Atelier.Core.Configuration
@using Geef.Atelier.Core.Domain.Intake
@using Geef.Atelier.Core.Domain.Orders
@using Geef.Atelier.Web.Components.UI.Orders
@using Microsoft.Extensions.Options
@inject IOrderService Orders
@inject AuthenticationStateProvider AuthProvider
@inject IRunUpdateFeed LiveUpdates
@inject CircuitDataGate DataGate
@inject ILogger<OrderDetail> Logger
@inject IJSRuntime JS
@inject IOptions<IntakeOptions> IntakeSettings
@inject IOptions<OrderOptions> OrderSettings

<PageTitle>@TabTitle</PageTitle>

<div class="order-page" data-testid="order-page">
    @if (_loadFailed && _view is null)
    {
        <div class="order-banner order-banner--failed" role="alert" data-testid="order-load-failed">
            <strong>This page could not be loaded.</strong>
            <span>Something went wrong on our side. Try again in a moment.</span>
            <button type="button" class="btn small" data-testid="order-reload" @onclick="ReloadAsync">Try again</button>
        </div>
    }
    else if (_unknownUser)
    {
        <div class="order-missing" data-testid="order-unknown-user">
            <EmptyState Message="@OwnerScope.UnknownUserMessage" />
        </div>
    }
    else if (!_loaded)
    {
        <EmptyState Message="Loading…" />
    }
    else if (_view is null)
    {
        <div class="order-missing" data-testid="order-not-found">
            <EmptyState Message="We could not find this. It may have been deleted, or it belongs to someone else." />
            <div class="order-empty-actions">
                <a class="btn primary" href="/work">Go to My work</a>
            </div>
        </div>
    }
    else
    {
        <nav class="crumb" aria-label="Breadcrumb">
            <a href="/work">My work</a>
            <span class="sep" aria-hidden="true">/</span>
            <span>@Shorten(_view.Title, 60)</span>
        </nav>

        <header class="order-head">
            <h1 class="order-title" data-testid="order-title">@_view.Title</h1>
            <div class="order-head-meta">
                <OrderStateBadge State="_view.Display.ShownState()" />
                <span class="order-head-date">Started @_view.CreatedAt.ToListDate()</span>
                @if (_view.Mode == OrderMode.Careful)
                {
                    <span class="order-head-mode" data-testid="order-mode-careful">Extra careful</span>
                }
            </div>
        </header>

        @if (_actionError is not null)
        {
            <div class="order-banner order-banner--failed" role="alert" data-testid="order-action-error">
                <strong>That did not work.</strong>
                <span>@_actionError</span>
                <button type="button" class="btn small" @onclick="() => _actionError = null">OK</button>
            </div>
        }

        @if (EarlierShownAfterChange)
        {
            <div class="order-banner order-banner--check" role="status" data-testid="order-banner" data-state="earlier-version">
                <strong>@(_view.Display.State == OrderDisplayState.Stopped ? "The change was stopped." : "The change could not be finished.")</strong>
                <span>The earlier version is still here.@(CanChange ? " You can try again with “" + RevisionLines.ChangeButton + "”." : "")</span>
                @if (_result?.HasOpenPoints() == true)
                {
                    <span data-testid="order-banner-check">@RevisionLines.EarlierStillToCheck</span>
                }
            </div>
        }
        else if (!IsAsking)
        {
            <OrderStatusBanner OrderId="_view.OrderId" Display="_view.Display" />
        }

        @if (_changeNotice is not null)
        {
            <p class="order-note" role="status" data-testid="order-change-notice">@_changeNotice</p>
        }

        <p class="clarify-live" aria-live="polite" data-testid="order-intake-status">@IntakeStatus</p>

        @if (_intakeNotice is not null)
        {
            <p class="order-note" role="status" data-testid="order-intake-notice">@_intakeNotice</p>
        }

        @if (IsReading)
        {
            <IntakeWaiting @key="_view.OrderId" OrderId="_view.OrderId" RequestingUsername="@_requestingUser" OnStarted="StartedAsync">
                <button type="button" class="btn small ghost" data-testid="order-stop" disabled="@_stopping" @onclick="StopAsync">
                    @(_stopping ? "Stopping…" : "Stop")
                </button>
            </IntakeWaiting>
        }
        else if (IsAsking)
        {
            <ClarifyCard @key="_view.OrderId" OrderId="_view.OrderId" Clarification="_view.Clarification!" RequestingUsername="@_requestingUser"
                         MaxFreeTextChars="IntakeSettings.Value.MaxFreeTextChars" OnStarted="StartedAsync">
                <button type="button" class="btn small ghost" data-testid="order-stop" disabled="@_stopping" @onclick="StopAsync">
                    @(_stopping ? "Stopping…" : "Stop")
                </button>
            </ClarifyCard>
        }
        else if (!_view.Display.IsFinished)
        {
            @if (StartedClarification is { } started)
            {
                <ClarificationSummary Clarification="started" />
            }
            <OrderProgressSteps Progress="_view.Progress" Elapsed="Elapsed">
                <button type="button" class="btn small ghost" data-testid="order-stop" disabled="@_stopping" @onclick="StopAsync">
                    @(_stopping ? "Stopping…" : "Stop")
                </button>
            </OrderProgressSteps>
        }

        @if (_result is { Text: not null } result)
        {
            @if (VersionCount > 1)
            {
                <p class="order-version-now@(NoteInStrip ? " is-earlier" : "")" role="status" data-testid="order-version-now">
                    <span>@(NoteInStrip ? result.Note : $"This is version {result.Version}, the newest.")</span>
                    <a href="@($"/orders/{_view.OrderId}#order-versions")" data-testid="order-versions-link">@(!NoteInStrip && result.Version is int shownVersion && _view.Runs.ComparedWith(shownVersion, shownVersion) is int ? RevisionLines.SeeChangesAndVersions : RevisionLines.SeeVersions)</a>
                </p>
            }
            <OrderResultPanel Result="result" />
            @if (ShowChangeCard)
            {
                <OrderChangeCard @key="_view.OrderId" OrderId="_view.OrderId" RequestingUsername="@_viewer" MaxChars="OrderSettings.Value.RevisionHintMaxChars"
                                 StartOpen="OpenChange" Draft="_changeDraft" OnDraft="d => _changeDraft = d" OnStarted="ChangeStartedAsync" />
            }
            <OrderChecksPanel Result="result" />
            <OrderOpenPoints Result="result" Language="@OrderLanguage" />
            <OrderAssumptions Result="result" Language="@OrderLanguage" />
            <OrderLookedUp LookedUp="result.LookedUp" />
            <OrderSourcesUsed Sources="result.SourcesUsed" Quotes="result.SourceQuotes" Language="@OrderLanguage" />
            @if (VersionCount > 1)
            {
                <OrderVersions OrderId="_view.OrderId" Runs="_view.Runs" ShownVersion="result.Version" RequestingUsername="@_requestingUser" Language="@OrderLanguage" />
            }
            @if (!NoteInStrip && !string.IsNullOrWhiteSpace(result.Note))
            {
                <p class="order-note" data-testid="order-note">@result.Note</p>
            }
        }

        @if (_result is { Text: not null, Version: int shownWarningsVersion, LatestVersion: int newWarningsVersion } && shownWarningsVersion < newWarningsVersion)
        {
            <RunWarningsBlock Warnings="ShownVersionWarnings" Status="ShownRunStatus" HasText="true" Version="shownWarningsVersion" />
            <RunWarningsBlock Warnings="NewVersionWarnings" Status="_view.CurrentRun?.Status" HasText="false" Version="newWarningsVersion" ShownVersion="shownWarningsVersion" />
        }
        else
        {
            <RunWarningsBlock Warnings="Warnings" Status="_view.CurrentRun?.Status" HasText="_view.Display.HasText" />
        }

        <details class="order-how" data-testid="order-how-made">
            <summary>How it was made</summary>
            <div class="order-how-body">
                <h3>Your request</h3>
                <p class="order-how-request" data-testid="order-how-request">@_view.RequestText</p>

                @if (StartedClarification is { } summary)
                {
                    <ClarificationSummary Clarification="summary" Inline="true" OnlyCorrectedAssumptions="AssumptionsShownAbove" />
                }

                <h3>Steps</h3>
                <ol class="order-how-steps">
                    @foreach (var step in _view.Progress.Steps)
                    {
                        <li data-testid="order-how-step">@step.Label — @StepSummary(step)</li>
                    }
                </ol>

                @if (_view.Sources.Count > 0)
                {
                    <h3>Your files</h3>
                    <ul class="order-how-files">
                        @foreach (var source in _view.Sources)
                        {
                            <li data-testid="order-how-file">@source.FileName · @source.CharCount.Grouped() characters@(source.PageCount is int pages ? $" · {pages.Grouped()} pages" : "")@(string.IsNullOrWhiteSpace(source.PageSelection) ? "" : $" · pages used: {source.PageSelection}")</li>
                        }
                    </ul>
                }

                @if (_result is { } checks && _view.Display.IsFinished)
                {
                    <h3>Automatic checks</h3>
                    @if (checks.Checks is not null)
                    {
                        <p data-testid="order-how-checks">See “What was checked” below your text.</p>
                    }
                    else
                    {
                        <p data-testid="order-how-checks">@(checks.OpenChecks.Count(c => c.Blocking) switch { 0 => "All automatic checks passed.", 1 => "One check is still open – see “Open points”.", var n => $"{n} checks are still open – see “Open points”." })</p>
                    }
                }

                @if (_view.Runs.Count > 0)
                {
                    <h3>Versions</h3>
                    <ul class="order-how-versions">
                        @foreach (var run in _view.Runs)
                        {
                            <li data-testid="order-how-version">
                                @(run.Version is int v ? $"Version {v}" : "Preparation") · @run.CreatedAt.ToListDate()@(run.WordCount is int words ? $" · {words.Grouped()} words" : "")
                            </li>
                        }
                    </ul>
                }

                @if (_view.CurrentRun is { } current)
                {
                    <WorkshopEntry>
                        <p class="order-how-tech"><a href="/runs/@current.RunId" data-testid="order-technical-details">Technical details</a></p>
                    </WorkshopEntry>
                }
            </div>
        </details>
    }
</div>

@code {
    [Parameter] public Guid OrderId { get; set; }

    /// <summary><c>?change=1</c> opens the card "Change something" when a change is possible; any other value is ignored.</summary>
    [SupplyParameterFromQuery(Name = "change")] public string? ChangeQuery { get; set; }

    bool OpenChange => ChangeQuery is "1" or "true";

    OrderView? _view;
    OrderResult? _result;
    bool _loaded;
    bool _loadFailed;
    bool _unknownUser;
    bool _stopping;
    string? _actionError;
    string? _intakeNotice;
    string? _changeNotice;
    OrderChangeDraft? _changeDraft;
    bool _isOwner;
    string? _requestingUser;
    string? _viewer;
    DateTimeOffset _loadedAt = DateTimeOffset.UtcNow;
    IDisposable? _subscription;
    IJSObjectReference? _titleModule;
    string? _shownTitle;
    System.Threading.Timer? _clock;
    bool _disposed;
    readonly CancellationTokenSource _disposeCts = new();

    TimeSpan Elapsed => _view is null ? TimeSpan.Zero : _view.Progress.Elapsed + (DateTimeOffset.UtcNow - _loadedAt);

    IReadOnlyList<Geef.Atelier.Core.Domain.Warnings.RunWarningEntity> Warnings =>
        (_result is { Warnings.Count: > 0 } r ? r.Warnings : _view?.Warnings ?? []).WithoutShownResearchWarning(ResultShown ? _result!.LookedUp : null);

    IReadOnlyList<Geef.Atelier.Core.Domain.Warnings.RunWarningEntity> ShownVersionWarnings =>
        (_result?.Warnings ?? []).WithoutShownResearchWarning(_result?.LookedUp);

    IReadOnlyList<Geef.Atelier.Core.Domain.Warnings.RunWarningEntity> NewVersionWarnings =>
        (_view?.Warnings ?? []).WithoutShownResearchWarning(_result?.LookedUp);

    RunStatus ShownRunStatus => _view?.Runs.LastOrDefault(r => r.RunId == _result?.RunId)?.Status ?? RunStatus.Completed;

    bool ResultShown => _result is { Text: not null } && _view is not null;

    int VersionCount => _view?.Runs.Where(r => r.Kind == RunKind.Standard && r.Version is not null).Select(r => r.Version).Distinct().Count() ?? 0;

    bool NoteInStrip => VersionCount > 1 && _result is { Text: not null, Version: int shownVersion, LatestVersion: int latest } shown && shownVersion < latest
        && !string.IsNullOrWhiteSpace(shown.Note);

    bool EarlierShownAfterChange => _view is { Display.IsFinished: true } && _view.Display.State is OrderDisplayState.Failed or OrderDisplayState.Stopped
        && _result is { Text: not null, Version: int shownVersion, LatestVersion: int latest } && shownVersion < latest;

    bool ShowChangeCard => CanChange || _changeDraft is not null && _isOwner && ResultShown && OrderSettings.Value.ReviseModeFor(_viewer) == ReviseMode.On;

    bool CanChange => _isOwner && _view is { Display.IsFinished: true } view && view.State != OrderState.Cancelled && ResultShown
        && !view.Runs.Any(r => r.Status is RunStatus.Pending or RunStatus.Running)
        && OrderSettings.Value.ReviseModeFor(_viewer) == ReviseMode.On;

    string TabTitle => _view is null
        ? "Your text — Atelier"
        : _view.Display.ShownState() == OrderDisplayState.NeedsInput
            ? $"{OrderDisplayState.NeedsInput.ToLabel()} – {Shorten(_view.Title, 40)} — Atelier"
            : $"{_view.Display.ShownState().ToLabel()} · {Shorten(_view.Title, 40)} — Atelier";

    bool AssumptionsShownAbove => _result is { Text: not null } shown && _view is not null
        && (shown.AllAssumptions().Count > 0 || shown.NotGivenFacts().Count > 0);

    string? OrderLanguage => string.IsNullOrWhiteSpace(_view?.Clarification?.Language) ? null : _view.Clarification.Language;

    bool IsReading => _view is { State: OrderState.Analyzing, Display.State: OrderDisplayState.Preparing };

    bool IsAsking => _view is { Display.State: OrderDisplayState.NeedsInput, Clarification: not null };

    ClarificationView? StartedClarification =>
        _view is { Clarification: { Outcome: not null and not IntakeOutcome.Asked } clarification } && !IsReading && !IsAsking
            ? clarification
            : null;

    string IntakeStatus => IsReading
        ? "Reading your request."
        : IsAsking
            ? _view!.Clarification!.Questions.Count switch
            {
                0 => "Before I start: please check my assumptions.",
                1 => "Before I start: one quick question.",
                var n => $"Before I start: {n} quick questions.",
            }
            : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        if (!auth.User.TryGetOwnerFilter(out _requestingUser))
        {
            _unknownUser = true;
            return;
        }
        _viewer = auth.User.Identity?.Name;

        await LoadAsync();
        _isOwner = _view is not null && !string.IsNullOrWhiteSpace(_viewer)
            && (_requestingUser is not null || await IsViewerOwnerAsync());
        if (_disposed)
            return;
        IDisposable? subscription = null;
        try
        {
            subscription = await LiveUpdates.WatchOrderAsync(auth.User, OrderId, async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }, _disposeCts.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Live updates for order {OrderId} could not be started", OrderId);
        }
        if (_disposed)
        {
            subscription?.Dispose();
            return;
        }
        _subscription = subscription;
        if (subscription is not null)
            await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
            _clock = new System.Threading.Timer(_ => _ = TickAsync(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        var title = TabTitle;
        if (title == _shownTitle || _disposed)
            return;
        _shownTitle = title;
        try
        {
            _titleModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/page-title.js");
            if (_titleModule is not null)
                await _titleModule.InvokeVoidAsync("set", title);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "Updating the tab title failed");
        }
    }

    async Task TickAsync()
    {
        if (_disposed || _view is null || _view.Display.IsFinished || IsReading || IsAsking)
            return;
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
    }

    Task LoadAsync() => DataGate.RunAsync(LoadCoreAsync);

    async Task LoadCoreAsync()
    {
        try
        {
            var view = await Orders.GetAsync(OrderId, _requestingUser);
            var result = view is not null && (view.Display.HasText || view.Runs.Count(r => r.Kind == RunKind.Standard && r.Version is not null) > 1)
                ? await Orders.GetResultAsync(OrderId, _requestingUser, _viewer)
                : null;
            _view = view;
            _result = result;
            if (view is { Display.IsFinished: true })
                _changeNotice = null;
            _loadedAt = DateTimeOffset.UtcNow;
            _loadFailed = false;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Loading order {OrderId} failed", OrderId);
            _loadFailed = true;
        }
        _loaded = true;
    }

    async Task ReloadAsync()
    {
        await LoadAsync();
    }

    async Task<bool> IsViewerOwnerAsync()
    {
        try
        {
            return await DataGate.RunAsync(() => Orders.GetAsync(OrderId, _viewer)) is not null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Checking the owner of order {OrderId} failed", OrderId);
            return false;
        }
    }

    async Task ChangeStartedAsync(OrderRevision revision)
    {
        _changeNotice = revision.Notices.Count > 0 ? string.Join(" ", revision.Notices) : null;
        await LoadAsync();
    }

    async Task StartedAsync(OrderSubmission submission)
    {
        _intakeNotice = submission.Notices.Count > 0 ? string.Join(" ", submission.Notices) : null;
        await LoadAsync();
    }

    async Task StopAsync()
    {
        _stopping = true;
        _actionError = null;
        try
        {
            var stopped = await DataGate.RunAsync(() => Orders.CancelAsync(OrderId, _requestingUser));
            if (!stopped)
                _actionError = "It could not be stopped, maybe because it has just finished. The page shows the current state.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Stopping order {OrderId} failed", OrderId);
            _actionError = "Something went wrong on our side. Try again in a moment.";
        }
        finally
        {
            _stopping = false;
        }
    }

    static string StepSummary(OrderStep step) => step switch
    {
        { Status: OrderStepStatus.Done, StartedAt: { } s, EndedAt: { } e } => $"done in {(e - s).ToClock()}",
        { Status: OrderStepStatus.Done } => "done",
        { Status: OrderStepStatus.Active } => "in progress",
        { Status: OrderStepStatus.Skipped } => "not needed",
        { Status: OrderStepStatus.Failed } => "stopped",
        _ => "not started",
    };

    static string Shorten(string text, int max) =>
        text.Length > max ? text[..max].TrimEnd() + "…" : text;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _disposeCts.Cancel();
        _subscription?.Dispose();
        _clock?.Dispose();
        if (_titleModule is not null)
        {
            try
            {
                await _titleModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
            {
                Logger.LogDebug(ex, "Releasing the title script failed");
            }
        }
    }
}
