@page "/runs/{runId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable
@inject IRunService RunService
@inject NavigationManager Nav
@inject ILogger<RunDetail> Logger
@inject AuthenticationStateProvider AuthProvider
@inject IRunUpdateFeed LiveUpdates
@inject CircuitDataGate DataGate
@inject IServiceProvider ServiceProvider
@using Geef.Atelier.Application.Runs
@using Geef.Atelier.Application.Orders
@using Geef.Atelier.Core.Domain
@using Geef.Atelier.Core.Domain.Crew
@using Geef.Atelier.Core.Configuration
@using Microsoft.Extensions.DependencyInjection
@using Geef.Atelier.Web.Display
@using Geef.Atelier.Web.Components.UI

<PageTitle>Run @_shortId — Geef.Atelier</PageTitle>

<div class="detail">
    @if (_unknownUser)
    {
        <div class="forbidden-banner" data-testid="run-unknown-user">
            <p>@OwnerScope.UnknownUserMessage</p>
        </div>
    }
    else if (_details is null && !_notFound && !_forbidden)
    {
        <EmptyState Message="Loading…" />
    }
    else if (_forbidden)
    {
        <div class="forbidden-banner">
            <h2>No access</h2>
            <p>This run belongs to another user.</p>
            <a href="/runs" class="btn ghost">← Back to all runs</a>
        </div>
    }
    else if (_notFound)
    {
        <EmptyState Message="Run not found." />
    }
    else if (_details is not null)
    {
        <div class="crumb">
            <a href="/runs">All runs</a>
            <span class="sep" aria-hidden="true">/</span>
            <span class="id t-mono">@_shortId</span>
        </div>

        <div class="run-header">
            <div>
                <div class="status-line">
                    <StatusBadge Status="_details.Run.Status" Large="true" />
                    <span class="t-eyebrow eyebrow">
                        Iteration @_details.Iterations.Count of @GetEffectiveMaxIterations()
                    </span>
                </div>
                <h1>@Truncate(BriefingSections.RequestPart(_details.Run.BriefingText), 100)</h1>
                <div class="briefing-block" data-testid="run-briefing">@ShownBriefing</div>
                @if (_details.Run.ErrorMessage is not null)
                {
                    <div class="error-banner" style="margin-top:18px;max-width:600px" role="alert">
                        @_details.Run.ErrorMessage
                    </div>
                }
            </div>
            <div class="run-meta">
                <div class="row"><span class="label">Submitted</span><span class="val">@_details.Run.CreatedAt.LocalDateTime.ToString("HH:mm")</span></div>
                <div class="row"><span class="label">Tokens</span><span class="val">@(_details.Run.TokensTotal > 0 ? _details.Run.TokensTotal.ToString("N0") : "—")</span></div>
                @if (_details.Run.CachedInputTokens is int cachedTok && cachedTok > 0)
                {
                    <div class="row"><span class="label">Cached input</span><span class="val" title="Sum of prompt-cache hits across all actor calls (billed at a reduced rate)">@cachedTok.ToString("N0")</span></div>
                }
                @if (_details.Run.ReasoningTokens is int reasoningTok && reasoningTok > 0)
                {
                    <div class="row"><span class="label">Reasoning</span><span class="val" title="Reasoning tokens across all actor calls">@reasoningTok.ToString("N0")</span></div>
                }
                <div class="row"><span class="label">Cost</span><span class="val" data-testid="run-cost">@FormatRunCost(_details.Run)</span></div>
                @if (_details.Run.ParentRunId.HasValue)
                {
                    <div class="row">
                        <span class="label">Resumed from</span>
                        <span class="val">
                            <a href="/runs/@_details.Run.ParentRunId.Value" class="t-mono">
                                @_details.Run.ParentRunId.Value.ToString("N")[..8].ToUpperInvariant()
                            </a>
                        </span>
                    </div>
                }
                @if (_details.Run.Status is RunStatus.Pending or RunStatus.Running)
                {
                    <div class="actions">
                        <CancelButton RunId="_details.Run.Id" OnCancelled="HandleCancelledAsync" />
                    </div>
                }
                @if (_details.Run.Status is RunStatus.Aborted or RunStatus.Failed)
                {
                    <div class="actions">
                        @if (ChangeOrderId is Guid changeOrderId)
                        {
                            <a class="btn secondary" href="@($"/orders/{changeOrderId}?change=1")" data-testid="resume-change-link">@RevisionLines.ChangeButton</a>
                        }
                        else if (_canResume && ResumeRefusal is null)
                        {
                            <button class="btn secondary" data-testid="resume-run-button"
                                    @onclick="OpenResumeDialog">
                                Resume
                            </button>
                        }
                        <button class="btn danger" data-testid="delete-run-button"
                                @onclick="() => _showDeleteModal = true">
                            Delete
                        </button>
                    </div>
                    @if (ChangeOrderId is null && ResumeRefusal is { } refusal)
                    {
                        <p class="text-muted" data-testid="resume-refusal">@refusal</p>
                    }
                }
                @if (_details.Run.Status is RunStatus.Completed)
                {
                    <div class="actions">
                        <button class="btn danger" data-testid="delete-run-button"
                                @onclick="() => _showDeleteModal = true">
                            Delete
                        </button>
                    </div>
                }
            </div>
        </div>

        @if (_resumeError is not null)
        {
            <div class="error-banner" role="alert" data-testid="resume-error">@_resumeError</div>
        }

        <RunWarningsBlock Warnings="_viewModel?.Warnings" Status="_details.Run.Status" HasText="@(!string.IsNullOrWhiteSpace(_details.Run.FinalText))" />

        <CrewSummary Snapshot="_snapshot" FallbackTemplateName="@_details.Run.CrewTemplateName" />

        <ResumeRunDialog
            Show="@_showResumeDialog"
            HasIterations="@(_details?.Iterations.Count > 0)"
            DefaultMaxIterations="@GetEffectiveMaxIterations()"
            ParentRunId="@RunId"
            OnConfirm="HandleResumeConfirmedAsync"
            OnCancel="() => _showResumeDialog = false" />

        <DeleteConfirmationModal
            Show="_showDeleteModal"
            ItemName="@_shortId"
            ItemKind="Run"
            OnConfirm="ExecuteDeleteAsync"
            OnCancel="() => _showDeleteModal = false" />

        <div class="iters">
            @{
                var resolvedMap = FindingResolutionInferrer.MarkResolved(_details!.Iterations);
            }
            @foreach (var (iwf, idx) in _details.Iterations.Select((x, i) => (x, i)))
            {
                <IterationPanel
                    Iteration="iwf.Iteration"
                    Findings="ProfileCopies.ForViewer(iwf.Findings, _details.Run.BriefingText, _details.Run.CreatedByUser, _viewerName)"
                    IsLast="@(idx == _details.Iterations.Count - 1)"
                    ResolvedMap="resolvedMap" />
                <IterationCostBlock Iteration="iwf.Iteration" />
            }
        </div>

        @if ((_details.Run.Status is RunStatus.Completed or RunStatus.Failed or RunStatus.Aborted)
             && !string.IsNullOrEmpty(_details.Run.FinalText))
        {
            <Manuscript Run="_details.Run" IterationCount="@_details.Iterations.Count" />
        }
    }
</div>

@code {
    [Parameter] public Guid RunId { get; set; }

    RunViewModel?  _viewModel;
    RunDetails?    _details;
    bool           _notFound;
    bool           _forbidden;
    IDisposable?   _subscription;
    bool           _disposed;
    readonly CancellationTokenSource _disposeCts = new();
    bool           _canResume;
    string?        _resumeError;
    CrewSnapshot?  _snapshot;
    string? _requestingUser;
    string? _viewerName;
    bool _unknownUser;
    bool _showResumeDialog;
    bool _showDeleteModal;

    string _shortId => RunId.ToString("N")[..8].ToUpperInvariant();

    /// <summary>
    /// The order of a run of the direct path whose owner may change texts and is the viewer: such a run is changed on the order page
    /// ("Change something"), never resumed here. Only when the order page can offer the change: the run has a text, or it is a later version
    /// (the version before it has one). <c>null</c> otherwise, and "Resume" stays.
    /// </summary>
    Guid? ChangeOrderId => _details?.Run is { OrderId: Guid orderId } run
        && SystemCrew.IsDirectPathTemplate(_snapshot?.TemplateName)
        && !string.IsNullOrWhiteSpace(_viewerName) && string.Equals(run.CreatedByUser, _viewerName, StringComparison.Ordinal)
        && (!string.IsNullOrWhiteSpace(run.FinalText) || run.OrderVersion > 1)
        && ServiceProvider.GetService<Microsoft.Extensions.Options.IOptions<OrderOptions>>()?.Value.ReviseModeFor(run.CreatedByUser) == ReviseMode.On
            ? orderId
            : null;

    /// <summary>
    /// Why "Resume" is not offered for a run that changed an earlier version and already has its own text (<see cref="ResumeRules.ResumeRefusal"/>):
    /// the sentence stands in place of the button, unless "Change something" is linked. <c>null</c> for every other run.
    /// </summary>
    string? ResumeRefusal => _details?.Run.ResumeRefusal();

    string ShownBriefing => _details is null ? string.Empty : BriefingSections.ForViewer(_details.Run.BriefingText, _details.Run.CreatedByUser, _viewerName);

    protected override async Task OnInitializedAsync()
    {
        var disposeToken = _disposeCts.Token;
        var auth     = await AuthProvider.GetAuthenticationStateAsync();
        if (!auth.User.TryGetOwnerFilter(out _requestingUser))
        {
            _unknownUser = true;
            return;
        }
        _viewerName = auth.User.Identity?.Name;

        await LoadAsync();
        if (_disposed)
            return;
        var subscription = await LiveUpdates.WatchRunAsync(auth.User, RunId, async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }, disposeToken);
        if (_disposed)
        {
            subscription?.Dispose();
            return;
        }
        _subscription = subscription;
        if (subscription is not null)
            await LoadAsync();
    }

    Task LoadAsync() => DataGate.RunAsync(LoadCoreAsync);

    async Task LoadCoreAsync()
    {
        _viewModel = await RunService.GetRunViewAsync(RunId, requestingUsername: _requestingUser, CancellationToken.None);
        _details   = _viewModel?.Details;
        _snapshot  = _viewModel?.Snapshot;
        _canResume = CrewSnapshot.IsUsableForRun(_details?.Run.CrewSnapshot);

        if (_viewModel is null)
        {
            // Distinguish 403 (run exists but belongs to another user) from 404
            if (_requestingUser is not null)
            {
                var adminView = await RunService.GetRunDetailsAsync(RunId, requestingUsername: null, CancellationToken.None);
                _forbidden = adminView is not null;
                _notFound  = !_forbidden;
            }
            else
            {
                _notFound = true;
            }
        }
        else
        {
            _forbidden = false;
            _notFound  = false;
        }
    }

    async Task HandleCancelledAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    void OpenResumeDialog() => _showResumeDialog = true;

    async Task ExecuteDeleteAsync()
    {
        _showDeleteModal = false;
        await DataGate.RunAsync(() => RunService.DeleteRunAsync(RunId, _requestingUser));
        Nav.NavigateTo("/runs");
    }

    int GetEffectiveMaxIterations()
    {
        if (_details?.Run.CrewSnapshot is { } json)
        {
            var snapshot = CrewSnapshot.Deserialize(json);
            if (snapshot?.ConvergenceOverride?.MaxIterations is { } max)
                return max;
        }
        return 3;
    }

    async Task HandleResumeConfirmedAsync(ResumeOptions opts)
    {
        _showResumeDialog = false;
        _resumeError = null;
        try
        {
            var newRunId = await DataGate.RunAsync(() => RunService.ResumeRunAsync(opts, _requestingUser));
            Nav.NavigateTo($"/runs/{newRunId}");
        }
        catch (RunNotResumableException ex)
        {
            _resumeError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Resume failed for run {RunId}", RunId);
            _resumeError = "The task could not be continued. Please try again.";
        }
    }

    static string Truncate(string s, int max) =>
        s.Length > max ? s[..max] + "…" : s;

    static string FormatCost(decimal eur)
    {
        if (eur < 0.01m) return $"~€{eur:F4}";
        return $"€{eur:F2}";
    }

    static string FormatRunCost(RunEntity run)
    {
        if (!run.TotalCostEur.HasValue)
            return "—";

        var total = FormatCost(run.TotalCostEur.Value);
        if (run.LlmCostEur.HasValue)
            return $"{total} (LLM: {FormatCost(run.LlmCostEur.Value)})";
        return total;
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        _disposeCts.Cancel();
        _subscription?.Dispose();
        return ValueTask.CompletedTask;
    }
}
