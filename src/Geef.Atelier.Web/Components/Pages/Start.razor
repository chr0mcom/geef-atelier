@page "/start"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable
@using Geef.Atelier.Application.Orders
@using Geef.Atelier.Application.Sources
@using Geef.Atelier.Core.Configuration
@using Geef.Atelier.Core.Domain.Orders
@using Geef.Atelier.Web.Components.UI.Orders
@using Microsoft.Extensions.Options
@inject IOrderService Orders
@inject ISourceIntakeService Intake
@inject IOptions<SourceOptions> SourceSettings
@inject IOptions<OrderOptions> OrderSettings
@inject AntiforgeryStateProvider AntiforgeryState
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject CircuitDataGate DataGate
@inject ILogger<Start> Logger

<PageTitle>New — Atelier</PageTitle>

<div class="start" @ref="_root" data-testid="start-page">
    <h1 class="start-title">What do you need written?</h1>

    @if (_prefillNote is not null)
    {
        <p class="start-note" data-testid="start-prefill-note">@_prefillNote</p>
    }

    <label class="start-label" for="start-request">Your request</label>
    <textarea id="start-request"
              class="start-request"
              data-testid="start-request"
              rows="6"
              maxlength="@OrderSettings.Value.RequestMaxChars"
              placeholder="Just describe it. For example: Write a short, friendly email to a customer about a two-week delivery delay."
              @bind="_request"
              @bind:event="oninput"></textarea>

    <div class="start-drop" data-upload-zone data-testid="start-drop">
        <input type="file" id="start-file-input" class="start-file-input" multiple
               accept=".pdf,.docx,.txt,.md,.markdown,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown"
               data-upload-input data-testid="start-file-input" />
        <label for="start-file-input" class="start-drop-label">
            <span class="start-drop-plus" aria-hidden="true">+</span>
            <span>Add files – drop, paste or <span class="start-drop-browse">browse</span> (PDF, Word, text)</span>
        </label>
        @if (_uploadAvailable == false)
        {
            <p class="start-drop-off" role="status" data-testid="start-upload-unavailable">Adding files does not work in this browser right now. Reload the page to try again, or start without files.</p>
        }
    </div>

    @if (_notice is not null)
    {
        <p class="start-notice" role="status" data-testid="start-notice">@_notice</p>
    }

    @if (_items.Count > 0)
    {
        <ul class="source-cards" data-testid="source-cards">
            @foreach (var item in _items)
            {
                <SourceReceiptCard @key="item.LocalId" Item="item" OnRemove="RemoveAsync" OnRetry="RetryAsync" OnPagesChanged="PagesChanged" />
            }
        </ul>
    }

    @if (BudgetLine is { } budget)
    {
        <p class="start-budget start-budget--@budget.Tone" data-testid="start-budget">@budget.Text</p>
    }

    <label class="start-careful">
        <input type="checkbox" data-testid="start-careful" @bind="_careful" />
        <span><strong>Extra careful</strong> <span class="start-careful-hint">(slower: several review rounds)</span></span>
    </label>

    @if (_error is not null)
    {
        <div class="order-banner order-banner--failed" role="alert" data-testid="start-error">
            <strong>@_error.Value.Title</strong>
            <span>@_error.Value.Message</span>
            <button type="button" class="btn small" data-testid="start-error-retry" disabled="@(!CanStart)" @onclick="SubmitAsync">Try again</button>
        </div>
    }

    <div class="start-actions">
        <button type="button" class="btn primary start-submit" data-testid="start-submit" disabled="@(!CanStart)" @onclick="SubmitAsync">
            @(_submitting ? "Starting…" : "Start")
        </button>
        @if (BlockedReason is { } reason)
        {
            <span class="start-blocked" data-testid="start-blocked-reason">@reason</span>
        }
    </div>

    <p class="start-more"><a href="/new" data-testid="start-more-options">More options (choose a team yourself)</a></p>
</div>

@code {
    private const string ModulePath = "./js/source-upload.js";

    [SupplyParameterFromQuery(Name = "from")] public Guid? From { get; set; }

    readonly List<SourceUploadItem> _items = [];
    ElementReference _root;
    string _request = string.Empty;
    bool _careful;
    bool _interactive;
    bool _submitting;
    bool? _uploadAvailable;
    string? _notice;
    string? _prefillNote;
    (string Title, string Message)? _error;
    string? _username;
    string? _requestingUser;
    IJSObjectReference? _module;
    IJSObjectReference? _handle;
    DotNetObjectReference<Start>? _self;
    bool _disposed;

    int MaxFiles => SourceSettings.Value.MaxFilesPerOrder;

    bool CanStart => _interactive && !_submitting && !string.IsNullOrWhiteSpace(_request) && !_items.Any(i => i.Blocks);

    string? BlockedReason =>
        _submitting ? null
        : !_interactive ? "Loading…"
        : _items.Any(i => i.Status == SourceUploadStatus.Uploading) ? "Wait until your files are read."
        : _items.Any(i => i.Blocks) ? "Remove the file that cannot be used, or try it again."
        : string.IsNullOrWhiteSpace(_request) ? "Describe what you need first."
        : null;

    (string Text, string Tone)? BudgetLine
    {
        get
        {
            var ready = _items.Where(i => i.Status == SourceUploadStatus.Ready && i.Receipt is not null).ToList();
            if (ready.Count == 0)
                return null;
            var total = ready.Sum(i => i.Receipt!.CharCount);
            var options = SourceSettings.Value;
            if (total <= options.FullTextMaxChars)
                return ($"Files: {total.Grouped()} of {options.FullTextMaxChars.Grouped()} characters used completely.", "ok");
            if (total <= options.MapMaxChars)
                return ($"Files: {total.Grouped()} characters. That is more than {options.FullTextMaxChars.Grouped()}, so the writer gets a table of contents and reads the parts that matter.", "map");
            return ($"Files: {total.Grouped()} characters. That is more than the limit of {options.MapMaxChars.Grouped()}. Enter the pages to use, or remove a file.", "over");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _username = auth.User.Identity?.Name;
        _requestingUser = auth.User.IsInRole("admin") ? null : _username;
        if (From is { } orderId)
            await PrefillAsync(orderId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _interactive = true;
        try
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            var token = AntiforgeryState.GetAntiforgeryToken()?.Value ?? string.Empty;
            _handle = await _module.InvokeAsync<IJSObjectReference>("init", _root, _self, new { url = "/api/sources", token });
            _uploadAvailable = _handle is not null;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogInformation(ex, "File upload script could not be loaded on the start page");
            _uploadAvailable = false;
        }
        if (_disposed)
            await ReleaseScriptAsync();
        StateHasChanged();
    }

    async Task PrefillAsync(Guid orderId)
    {
        try
        {
            var found = await DataGate.RunAsync<EarlierOrder?>(async () =>
            {
                var view = await Orders.GetAsync(orderId, _requestingUser);
                if (view is null)
                    return null;
                var receipts = new List<(OrderSourceView Source, SourceReceipt? Receipt)>();
                foreach (var source in view.Sources)
                    receipts.Add((source, await Intake.GetReceiptAsync(source.SourceId, _requestingUser)));
                return new EarlierOrder(view, receipts);
            });
            if (found is null)
            {
                _prefillNote = "We could not find your earlier request. Describe what you need below.";
                return;
            }
            _request = found.View.RequestText;
            _careful = found.View.Mode == OrderMode.Careful;
            var missing = 0;
            foreach (var (source, receipt) in found.Receipts)
            {
                if (receipt is not { Usable: true, SourceId: not null })
                {
                    missing++;
                    continue;
                }
                _items.Add(new SourceUploadItem($"earlier-{source.SourceId:N}", receipt.FileName, receipt.SizeBytes)
                {
                    Receipt = receipt,
                    Status = SourceUploadStatus.Ready,
                    Percent = 100,
                    Pages = source.PageSelection,
                    FromEarlierOrder = true,
                });
            }
            _prefillNote = missing == 0
                ? "Your earlier request is filled in. Change it if you like, then press Start."
                : $"Your earlier request is filled in, but {missing} of its files are no longer available. Add them again if you need them.";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Could not load order {OrderId} to start again", orderId);
            _prefillNote = "We could not load your earlier request. Describe what you need below.";
        }
    }

    /// <summary>Called by the upload script before a file is sent; returns false when the file is not sent.</summary>
    [JSInvokable]
    public async Task<bool> OnUploadStarted(string localId, string fileName, long sizeBytes, string? hint)
    {
        _notice = null;
        if (_items.Count(i => i.Status is not SourceUploadStatus.Unusable and not SourceUploadStatus.Failed) >= MaxFiles)
        {
            _notice = $"You can add up to {MaxFiles} files. “{fileName}” was not added.";
            await InvokeAsync(StateHasChanged);
            return false;
        }
        var item = new SourceUploadItem(localId, fileName, sizeBytes) { Hint = hint };
        var maxBytes = SourceSettings.Value.MaxFileBytes;
        if (sizeBytes > maxBytes)
        {
            item.Status = SourceUploadStatus.Unusable;
            item.Problem = $"This file is larger than {maxBytes.ToFileSize()}. Remove it, or try a smaller file.";
            _items.Add(item);
            await InvokeAsync(StateHasChanged);
            return false;
        }
        _items.Add(item);
        await InvokeAsync(StateHasChanged);
        return true;
    }

    /// <summary>Called by the upload script while a file is being sent.</summary>
    [JSInvokable]
    public async Task OnUploadProgress(string localId, int percent)
    {
        if (Find(localId) is not { Status: SourceUploadStatus.Uploading } item)
            return;
        item.Percent = Math.Clamp(percent, 0, 100);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Called by the upload script with the answer of the server (status 0 = no answer).</summary>
    [JSInvokable]
    public async Task OnUploadCompleted(string localId, int status, string? body)
    {
        if (Find(localId) is not { } item)
            return;
        item.ApplyResponse(status, body, SourceSettings.Value.MaxFileBytes);
        if (item.Status == SourceUploadStatus.Ready
            && _items.Any(other => other != item && other.Status == SourceUploadStatus.Ready && other.Receipt?.SourceId == item.Receipt!.SourceId))
        {
            _items.Remove(item);
            _notice = $"“{item.FileName}” is already in the list.";
            await ForgetAsync(item);
        }
        else if (item.Status == SourceUploadStatus.Ready)
        {
            await ForgetAsync(item);
        }
        await InvokeAsync(StateHasChanged);
    }

    async Task RemoveAsync(SourceUploadItem item)
    {
        _items.Remove(item);
        _notice = null;
        await ForgetAsync(item);
        if (item is { FromEarlierOrder: false, Status: SourceUploadStatus.Ready, Receipt.SourceId: { } sourceId }
            && !_items.Any(other => other.Receipt?.SourceId == sourceId)
            && _module is not null && _handle is not null)
        {
            try
            {
                await _module.InvokeAsync<int>("removeSource", _handle, sourceId.ToString());
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
            {
                Logger.LogDebug(ex, "Removing source {SourceId} from the server failed; the cleanup job removes it later", sourceId);
            }
        }
    }

    async Task RetryAsync(SourceUploadItem item)
    {
        if (_module is null || _handle is null)
            return;
        try
        {
            if (await _module.InvokeAsync<bool>("retry", _handle, item.LocalId))
            {
                item.Status = SourceUploadStatus.Uploading;
                item.Percent = 0;
                item.Problem = null;
                item.Recovery = SourceUploadRecovery.None;
            }
            else
            {
                item.Problem = "This file can no longer be sent. Remove it and add it again.";
                item.Recovery = SourceUploadRecovery.None;
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            Logger.LogDebug(ex, "Retrying upload {LocalId} failed", item.LocalId);
        }
    }

    void PagesChanged(SourceUploadItem item) => _error = null;

    async Task ForgetAsync(SourceUploadItem item)
    {
        if (_module is null || _handle is null)
            return;
        try
        {
            await _module.InvokeVoidAsync("forget", _handle, item.LocalId);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            Logger.LogDebug(ex, "Releasing upload {LocalId} in the browser failed", item.LocalId);
        }
    }

    async Task SubmitAsync()
    {
        if (!CanStart || _username is null)
            return;
        _submitting = true;
        _error = null;
        try
        {
            var sources = _items
                .Where(i => i is { Status: SourceUploadStatus.Ready, Receipt.SourceId: not null })
                .Select(i => new OrderSourceSelection(i.Receipt!.SourceId!.Value, i.Pages))
                .ToList();
            var request = new SubmitOrderRequest(
                _request,
                _username,
                OrderEntry.Web,
                sources,
                _careful ? OrderMode.Careful : OrderMode.Direct);
            var submission = await DataGate.RunAsync(() => Orders.SubmitAsync(request));
            Nav.NavigateTo($"/orders/{submission.OrderId}");
        }
        catch (OrderSubmissionException ex)
        {
            _error = ("This could not start.", ex.Message);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Starting an order failed");
            _error = ("Something went wrong on our side.", "Your text and files are still here. Try again in a moment.");
        }
        finally
        {
            _submitting = false;
        }
    }

    sealed record EarlierOrder(OrderView View, IReadOnlyList<(OrderSourceView Source, SourceReceipt? Receipt)> Receipts);

    SourceUploadItem? Find(string localId) => _items.FirstOrDefault(i => i.LocalId == localId);

    async Task ReleaseScriptAsync()
    {
        try
        {
            if (_module is not null && _handle is not null)
                await _module.InvokeVoidAsync("dispose", _handle);
            if (_handle is not null)
                await _handle.DisposeAsync();
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            Logger.LogDebug(ex, "Releasing the upload script failed");
        }
        _handle = null;
        _module = null;
        _self?.Dispose();
        _self = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await ReleaseScriptAsync();
    }
}
