<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Geef.Atelier.Tests</RootNamespace>
    <AssemblyName>Geef.Atelier.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Geef.Atelier.Application\Geef.Atelier.Application.csproj" />
    <ProjectReference Include="..\..\src\Geef.Atelier.Core\Geef.Atelier.Core.csproj" />
    <ProjectReference Include="..\..\src\Geef.Atelier.Infrastructure\Geef.Atelier.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Geef.Atelier.Mcp\Geef.Atelier.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Geef.Atelier.Web\Geef.Atelier.Web.csproj" />
  </ItemGroup>

  <ItemGroup Label="Evaluation code of tools/IntakeEval, compiled in so that the tests judge with the same code as the tool">
    <Compile Include="..\..\tools\IntakeEval\CorpusEntry.cs" Link="Intake\IntakeEval\CorpusEntry.cs" />
    <Compile Include="..\..\tools\IntakeEval\EvalResult.cs" Link="Intake\IntakeEval\EvalResult.cs" />
    <Compile Include="..\..\tools\IntakeEval\EntryMapping.cs" Link="Intake\IntakeEval\EntryMapping.cs" />
    <Compile Include="..\..\tools\IntakeEval\CorpusEvaluation.cs" Link="Intake\IntakeEval\CorpusEvaluation.cs" />
    <Compile Include="..\..\tools\IntakeEval\ShadowEvaluation.cs" Link="Intake\IntakeEval\ShadowEvaluation.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Domain/Checks/Corpus/*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
