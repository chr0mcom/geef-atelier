# Geef.Atelier — Environment Variables
# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# PostgreSQL
POSTGRES_DB=geef_atelier
POSTGRES_USER=geef_atelier
POSTGRES_PASSWORD=<generate: openssl rand -base64 24>

# First administrator (further accounts are created in the app under /admin/users)
# Keep the single quotes around the hash: without them Docker Compose reads every "$" as a variable and the sign-in fails.
ATELIER_USER=admin
ATELIER_PASSWORD_HASH='<generate: dotnet run --project tools/HashPassword -- "YourPassword">'

# MCP Bearer Token
ATELIER_MCP_TOKEN=<generate: openssl rand -hex 32>

# One shared secret for the web app and the AI gateway (cli-proxy): the gateway sends it when it fetches the settings of
# the CLI providers. Set one value here, Docker Compose passes it to both services. Create it with: openssl rand -hex 32
# While it is empty the web app refuses that request: the built-in CLI providers keep working, own CLI providers do not
# reach the gateway.
ATELIER_INTERNAL_API_TOKEN=

# Traefik domain (used in docker-compose.yml labels)
ATELIER_DOMAIN=<your-domain>

# LLM providers
LLM_OPENROUTER_API_KEY=<your-openrouter-api-key>

# Tavily Web Search — optional, only needed when looking things up on the web (Research:Mode) is on
TAVILY_API_KEY=
